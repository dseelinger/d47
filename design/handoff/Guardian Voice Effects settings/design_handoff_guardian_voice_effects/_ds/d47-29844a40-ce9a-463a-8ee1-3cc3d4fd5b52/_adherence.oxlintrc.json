{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Controls/ApiKey/**",
              "components/Chrome/Card/**",
              "components/Controls/CheckboxTile/**",
              "components/Data/DataBlock/**",
              "components/Controls/Dropdown/**",
              "components/Controls/GlyphButton/**",
              "components/Layout/GroupHead/**",
              "components/Controls/KeyBinding/**",
              "components/Controls/LevelBar/**",
              "components/Controls/ListBoxItem/**",
              "components/Data/Message/**",
              "components/Controls/MixerTable/**",
              "components/Data/Modal/**",
              "components/Controls/NumberStepper/**",
              "components/Foundations/Palette/**",
              "components/Controls/SearchField/**",
              "components/Controls/Segmented/**",
              "components/Layout/SettingsRow/**",
              "components/Data/StatusRow/**",
              "components/Controls/Stepper/**",
              "components/Foundations/Surfaces/**",
              "components/Navigation/Tab/**",
              "components/Controls/TextBox/**",
              "components/Controls/TileButton/**",
              "components/Foundations/TypeScale/**"
            ],
            "message": "d47 has no React components. Write the markup from the card's .prompt.md with the d47- classes."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Saira|Sintony|JetBrains Mono|var\\(--d47-font-))/i]",
        "message": "Font not provided by the design system. Available: Saira, Sintony, JetBrains Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ApiKey": {
        "replaces": []
      },
      "Card": {
        "replaces": []
      },
      "CheckboxTile": {
        "replaces": []
      },
      "DataBlock": {
        "replaces": []
      },
      "Dropdown": {
        "replaces": []
      },
      "GlyphButton": {
        "replaces": []
      },
      "GroupHead": {
        "replaces": []
      },
      "KeyBinding": {
        "replaces": []
      },
      "LevelBar": {
        "replaces": []
      },
      "ListBoxItem": {
        "replaces": []
      },
      "Message": {
        "replaces": []
      },
      "MixerTable": {
        "replaces": []
      },
      "Modal": {
        "replaces": []
      },
      "NumberStepper": {
        "replaces": []
      },
      "Palette": {
        "replaces": []
      },
      "SearchField": {
        "replaces": []
      },
      "Segmented": {
        "replaces": []
      },
      "SettingsRow": {
        "replaces": []
      },
      "StatusRow": {
        "replaces": []
      },
      "Stepper": {
        "replaces": []
      },
      "Surfaces": {
        "replaces": []
      },
      "Tab": {
