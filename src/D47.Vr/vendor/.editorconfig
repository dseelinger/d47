# Valve's generated openvr_api.cs, vendored verbatim (architecture.md D2). Silenced by folder
# rather than edited into compliance: editing it is what would make the next refresh from
# ValveSoftware/openvr a merge instead of a copy. Nothing else lives in here.
root = false

