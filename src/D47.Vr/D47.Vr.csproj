<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>D47.Vr</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Valve's own openvr_api.cs, vendored rather than packaged. There is no canonical Valve
    NuGet package for the C# bindings, and a stale third-party one fails as an FnTable vtable
    mismatch - the wrong function called, no error - rather than as anything diagnosable
    (architecture.md D2). It is generated, it is BSD-3, and it is never edited: the version
    constant is pinned by a test instead.

    Excluded from analysis by folder rather than edited into compliance, because editing it is
    what would make the next refresh a merge instead of a copy.
  -->
  <ItemGroup>
    <ProjectReference Include="..\D47.Core\D47.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
