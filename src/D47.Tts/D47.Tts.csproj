<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Speech synthesis providers, behind Core's ITtsProvider. Separate from D47.Audio because
    this is a network client and that is a sound card: they fail differently, they are
    configured differently, and Phase 11's paid provider lands here without touching the
    rendering path.
  -->

  <ItemGroup>
    <ProjectReference Include="..\D47.Core\D47.Core.csproj" />
  </ItemGroup>

  <!--
    NAudio here is the MP3 decoder, nothing else. The endpoint dropped its raw-PCM output
    format in mid-2026, so the audio arrives as 24 kHz mono MP3 and is decoded through
    Windows' own ACM codec — built into the OS, MIT-wrapped, and still no FFmpeg anywhere
    in the graph (architecture.md §10).
  -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!--
    ONNX Runtime runs the local voice (#101). It is the only way to run Kokoro without Python;
    and it is the same version (1.29.0) the spike measured, so the licence finding and the
    latency figures describe one artifact.
    
    Its nuspec declares MIT and its LICENSE file is MIT, so PackageLicenceGateTests passes it.
    That gate reads only the licence file a nuspec names, and this package vendors more than
    that file covers: ThirdPartyNotices.txt carries Eigen under MPL-2.0, quoted in full. The
    exposure was read and accepted on 2026-08-25 and is discharged by the NOTICE entry naming
    Eigen, its licence and the commit ONNX Runtime pins it at. Permissive is deliberately NOT
    widened: it never saw this MPL, and widening would lower the floor for a package that
    genuinely declares one.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
  </ItemGroup>

  <!--
    The wire format is internal because nothing outside this assembly should be composing
    Edge's frames, but it is exactly the part that can be wrong without the network being
    involved, so the tests reach it directly.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="D47.Tts.Tests" />
  </ItemGroup>

</Project>
