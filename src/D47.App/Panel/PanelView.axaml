<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panel="clr-namespace:D47.App.Panel"
             x:Class="D47.App.Panel.PanelView"
             x:DataType="panel:PanelViewModel"
             Background="{DynamicResource D47.Background}"
             Foreground="{DynamicResource D47.Text}">

  <!--
    One view definition, instantiated twice: once by the desktop window, once by the VR
    overlay, both bound to one PanelViewModel. A Visual belongs to exactly one visual tree so
    the framework will not render a single instance to two targets, but the constraint the
    checklist is protecting is satisfied either way - there is no second UI codebase and no
    path where the VR surface is a screenshot of the desktop one (architecture.md D1).

    Nothing here knows about a window. That is what makes the overlay path minimise-safe:
    there is no TopLevel in it to be minimised.

    Mini is a mode of this panel, not another one. The rows mini does without bind IsFull.

    Colour by role, never by literal: every brush is a theme resource, so switching theme
    repaints this without it knowing a theme exists (list.md Phase 4).
  -->
  <DockPanel Margin="24,16,24,24">

    <!--
      LastChildFill is off because there is no last child to fill with: the version line that
      used to sit on the left has moved to the title bar, and without this the final docked
      button silently stops docking and stretches across the header instead.
    -->
    <DockPanel x:Name="Header" DockPanel.Dock="Top" LastChildFill="False">
      <!--
        A gear, not a labelled button: this is reached once a session and every desktop app of
        the last decade puts one here, so the convention carries it without spending a word of
        the header on it. The geometry is authored in-repo rather than lifted from an icon set,
        which keeps the licence graph as clean as the dependency graph.
      -->
      <Button x:Name="SettingsButton"
              DockPanel.Dock="Right"
              Padding="9"
              VerticalAlignment="Top"
              CornerRadius="4"
              Background="Transparent"
              BorderThickness="0"
              Click="OnSettingsClick"
              PointerEntered="OnSettingsPointerEntered"
              PointerExited="OnSettingsPointerExited">
        <Path x:Name="SettingsGlyph"
              Width="17" Height="17"
              Stretch="Uniform"
              Fill="{DynamicResource D47.TextMuted}"
              Data="M 9.59,4.16 L 10.19,1.15 L 13.81,1.15 L 14.41,4.16 L 15.84,4.75 L 18.40,3.05 L 20.95,5.60 L 19.25,8.16 L 19.84,9.59 L 22.85,10.19 L 22.85,13.81 L 19.84,14.41 L 19.25,15.84 L 20.95,18.40 L 18.40,20.95 L 15.84,19.25 L 14.41,19.84 L 13.81,22.85 L 10.19,22.85 L 9.59,19.84 L 8.16,19.25 L 5.60,20.95 L 3.05,18.40 L 4.75,15.84 L 4.16,14.41 L 1.15,13.81 L 1.15,10.19 L 4.16,9.59 L 4.75,8.16 L 3.05,5.60 L 5.60,3.05 L 8.16,4.75 Z M 12.00,8.00 A 4.0,4.0 0 1 1 11.99,8.00 Z" />
      </Button>
      <!--
        Help, beside the gear, and drawn rather than typed. A "?" set as text was a character in
        a font: lighter than the gear beside it, and sitting on a baseline rather than in the
        middle of its box, so it read as smaller and hung high. This is the same 24-unit
        coordinate space as the gear above, scaled into the same 17-pixel box from a button with
        the same padding, so the two line up by construction rather than by adjustment.

        Stroked rather than filled, because thickness is the property being matched and a stroke
        states it directly. The dot is a zero-length segment with a round cap - a line from a
        point to itself, drawn as a disc exactly as wide as the stroke, which keeps it in step
        with the hook for free.
      -->
      <Button x:Name="HelpButton"
              DockPanel.Dock="Right"
              Padding="9"
              VerticalAlignment="Top"
              CornerRadius="4"
              Background="Transparent"
              BorderThickness="0"
              ToolTip.Tip="Open the documentation"
              Click="OnHelpClick"
              PointerEntered="OnHelpPointerEntered"
              PointerExited="OnHelpPointerExited">
        <Path x:Name="HelpGlyph"
              Width="17" Height="17"
              Stretch="Uniform"
              Stroke="{DynamicResource D47.TextMuted}"
              StrokeThickness="2.8"
              StrokeLineCap="Round"
              StrokeJoin="Round"
              Data="M 7.4,7.6 A 4.6,4.6 0 1 1 12,12.2 L 12,15.5 M 12,20.2 L 12,20.2" />
      </Button>

      <!-- Nothing on the left. The build was here and has moved: the short version to the title
           bar, which is on screen anyway, and the exact one to the About dialog, which is where
           a forty-character commit hash belongs. A line the Commander reads once and then reads
           past for the rest of the session was not worth the panel's best space. -->
    </DockPanel>

    <!-- Both banners in one region, so mini hides them with one line and each still decides
         for itself whether it has anything to say. -->
    <StackPanel x:Name="Banners" DockPanel.Dock="Top">

    <!-- Settings that failed to load are said out loud, not swallowed. -->
    <Border x:Name="ErrorBanner"
            IsVisible="{Binding HasError}"
            Margin="0,14,0,0"
            Padding="12"
            CornerRadius="4"
            Background="{DynamicResource D47.SurfaceAlt}"
            BorderBrush="{DynamicResource D47.Danger}"
            BorderThickness="1">
      <SelectableTextBlock x:Name="ErrorText"
                           Text="{Binding ErrorText}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource D47.Danger}" />
    </Border>

    <!-- Hidden until a background check finds a newer release; never blocks startup. -->
    <Border x:Name="UpdateBanner"
            IsVisible="{Binding HasUpdate}"
            Margin="0,14,0,0"
            Padding="12"
            CornerRadius="4"
            Background="{DynamicResource D47.SurfaceAlt}"
            BorderBrush="{DynamicResource D47.Info}"
            BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding UpdateActionable}">
          <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNowClick" />
          <Button x:Name="UpdateLaterButton" Content="Later" Click="OnUpdateLaterClick" />
        </StackPanel>
        <TextBlock x:Name="UpdateText"
                   Text="{Binding UpdateText}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    </StackPanel>

    <!-- Ask box. Enter sends; the button is for discoverability. -->
    <Border x:Name="AskRow" DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <DockPanel>
        <!-- The send glyph, drawn in-repo like the gear. The label is gone because a paper
             aeroplane next to a text box needs no caption anywhere a Commander has been. -->
        <Button x:Name="AskButton"
                DockPanel.Dock="Right"
                Margin="8,0,0,0"
                Padding="11,7"
                CornerRadius="4"
                IsEnabled="{Binding CanAsk}"
                Background="{DynamicResource D47.SurfaceAlt}"
                BorderBrush="{DynamicResource D47.Border}"
                BorderThickness="1"
                ToolTip.Tip="Send (Enter)"
                Click="OnAskClick">
          <Path x:Name="AskGlyph"
                Width="17" Height="17"
                Stretch="Uniform"
                Fill="{DynamicResource D47.Accent}"
                Data="M 2.5,3 L 22,12 L 2.5,21 L 2.5,13.6 L 14.5,12 L 2.5,10.4 Z" />
        </Button>
        <TextBox x:Name="AskBox"
                 Text="{Binding AskText, Mode=TwoWay}"
                 PlaceholderText="Ask D47 something — try &quot;where am I&quot; or &quot;what's your status&quot;"
                 KeyDown="OnAskBoxKeyDown" />
      </DockPanel>
    </Border>

    <!-- One line of provenance per turn: which path answered, at what effort, for what. -->
    <TextBlock x:Name="TurnLine"
               Text="{Binding TurnLine}"
               DockPanel.Dock="Bottom"
               Margin="0,10,0,0"
               FontFamily="Cascadia Mono,Consolas,monospace"
               FontSize="11"
               Foreground="{DynamicResource D47.TextMuted}"
               TextWrapping="Wrap" />

    <Border Background="{DynamicResource D47.Surface}"
            BorderBrush="{DynamicResource D47.Border}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14"
            Margin="0,16,0,0">
      <ScrollViewer x:Name="TranscriptScroller">
        <SelectableTextBlock x:Name="Transcript"
                             Text="{Binding TranscriptText}"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             FontSize="12"
                             TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

  </DockPanel>
</UserControl>
