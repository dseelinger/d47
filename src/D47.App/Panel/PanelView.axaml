<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panel="clr-namespace:D47.App.Panel"
             xmlns:controls="clr-namespace:D47.App.Controls"
             x:Class="D47.App.Panel.PanelView"
             x:DataType="panel:PanelViewModel"
             Background="{DynamicResource D47.Background}"
             Foreground="{DynamicResource D47.Text}">

  <!--
    One view definition, instantiated twice: once by the desktop window, once by the VR
    overlay, both bound to one PanelViewModel. A Visual belongs to exactly one visual tree so
    the framework will not render a single instance to two targets, but the constraint the
    checklist is protecting is satisfied either way - there is no second UI codebase and no
    path where the VR surface is a screenshot of the desktop one (architecture.md D1).

    Nothing here knows about a window. That is what makes the overlay path minimise-safe: the
    window the VR surface hosts this in is constructed and never shown, so there is no window
    state for a minimise to put it in.

    Mini is a mode of this panel, not another one. The rows mini does without bind IsFull.

    Colour by role, never by literal: every brush is a theme resource, so switching theme
    repaints this without it knowing a theme exists (list.md Phase 4).
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://d47/Panel/TranscriptTabs.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="24,16,24,24">

    <!--
      LastChildFill is off because there is no last child to fill with: the version line that
      used to sit on the left has moved to the title bar, and without this the final docked
      button silently stops docking and stretches across the header instead.
    -->
    <DockPanel x:Name="Header" DockPanel.Dock="Top" LastChildFill="False">
      <!--
        Help. The gear used to sit beside it and no longer does: settings is a page of this panel
        now, chosen from the tab strip below like every other page, and a second affordance
        opening the same page would be a second thing to keep in step (list.md Phase 12).

        Drawn rather than typed. A "?" set as text was a character in a font: lighter than the
        glyph beside it, and sitting on a baseline rather than in the middle of its box, so it
        read as smaller and hung high. This is a 24-unit coordinate space scaled into a
        17-pixel box, so it lines up by construction rather than by adjustment.

        Stroked rather than filled, because thickness is the property being matched and a stroke
        states it directly. The dot is a zero-length segment with a round cap - a line from a
        point to itself, drawn as a disc exactly as wide as the stroke, which keeps it in step
        with the hook for free.
      -->
      <Button x:Name="HelpButton"
              DockPanel.Dock="Right"
              Padding="9"
              VerticalAlignment="Top"
              CornerRadius="4"
              Background="Transparent"
              BorderThickness="0"
              ToolTip.Tip="Open the documentation"
              Click="OnHelpClick"
              PointerEntered="OnHelpPointerEntered"
              PointerExited="OnHelpPointerExited">
        <Path x:Name="HelpGlyph"
              Width="17" Height="17"
              Stretch="Uniform"
              Stroke="{DynamicResource D47.TextMuted}"
              StrokeThickness="2.8"
              StrokeLineCap="Round"
              StrokeJoin="Round"
              Data="M 7.4,7.6 A 4.6,4.6 0 1 1 12,12.2 L 12,15.5 M 12,20.2 L 12,20.2" />
      </Button>

      <!--
        The ship AI's face, on the left, where the build line used to be. It earns that space in
        a way a version string never did: it is the one thing on the panel that says what D47 is
        doing right now without the Commander reading anything, which is the whole point in a
        cockpit. Drawn rather than decoded — see AvatarView for why that is not an aesthetic
        choice — and present in mini too, since a reduced content set is exactly where a glance
        has to carry more.
      -->
      <panel:AvatarView x:Name="Avatar"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0" />
    </DockPanel>

    <!-- Both banners in one region, so mini hides them with one line and each still decides
         for itself whether it has anything to say. -->
    <StackPanel x:Name="Banners" DockPanel.Dock="Top">

    <!-- Settings that failed to load are said out loud, not swallowed. Dismissable, because a
         fault the Commander has read and decided about should not go on taking a strip off the
         top of the panel for the rest of the session — and the same fault arising again raises
         it again, so dismissing hides a message rather than muting a problem. -->
    <Border x:Name="ErrorBanner"
            IsVisible="{Binding HasError}"
            Margin="0,14,0,0"
            Padding="12"
            CornerRadius="4"
            Background="{DynamicResource D47.SurfaceAlt}"
            BorderBrush="{DynamicResource D47.Danger}"
            BorderThickness="1">
      <DockPanel>
        <Button x:Name="DismissErrorButton"
                DockPanel.Dock="Right"
                Margin="10,0,0,0"
                Padding="7,1"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource D47.Danger}"
                FontSize="{StaticResource D47.Type.Body}"
                Content="&#x2715;"
                ToolTip.Tip="Dismiss"
                Click="OnDismissErrorClick" />
        <SelectableTextBlock x:Name="ErrorText"
                             Text="{Binding ErrorText}"
                             TextWrapping="Wrap"
                             FontSize="{StaticResource D47.Type.Body}"
                             Foreground="{DynamicResource D47.Danger}" />
      </DockPanel>
    </Border>

    <!-- Hidden until a background check finds a newer release; never blocks startup. -->
    <Border x:Name="UpdateBanner"
            IsVisible="{Binding HasUpdate}"
            Margin="0,14,0,0"
            Padding="12"
            CornerRadius="4"
            Background="{DynamicResource D47.SurfaceAlt}"
            BorderBrush="{DynamicResource D47.Info}"
            BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    IsVisible="{Binding UpdateActionable}">
          <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNowClick" />
          <Button x:Name="UpdateLaterButton" Content="Later" Click="OnUpdateLaterClick" />
        </StackPanel>
        <TextBlock x:Name="UpdateText"
                   Text="{Binding UpdateText}"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource D47.Type.Body}"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>


    </StackPanel>

    <!-- Ask box. Enter sends; the button is for discoverability. -->
    <Border x:Name="AskRow" DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <DockPanel>
        <!-- The send glyph, drawn in-repo like the help mark. The label is gone because a paper
             aeroplane next to a text box needs no caption anywhere a Commander has been. -->
        <Button x:Name="AskButton"
                DockPanel.Dock="Right"
                Margin="8,0,0,0"
                Padding="11,7"
                CornerRadius="4"
                IsEnabled="{Binding CanAsk}"
                Background="{DynamicResource D47.SurfaceAlt}"
                BorderBrush="{DynamicResource D47.Border}"
                BorderThickness="1"
                ToolTip.Tip="Send (Enter)"
                Click="OnAskClick">
          <Path x:Name="AskGlyph"
                Width="17" Height="17"
                Stretch="Uniform"
                Fill="{DynamicResource D47.Accent}"
                Data="M 2.5,3 L 22,12 L 2.5,21 L 2.5,13.6 L 14.5,12 L 2.5,10.4 Z" />
        </Button>
        <!-- The placeholder is set in code rather than bound; see ApplyAskHint for why a
             binding on this particular control is the wrong tool. -->
        <TextBox x:Name="AskBox"
                 Text="{Binding AskText, Mode=TwoWay}"
                 KeyDown="OnAskBoxKeyDown" />
      </DockPanel>
    </Border>

    <!--
      The provenance line, and beside it the one thing on this panel that is about right now
      rather than about the last turn: whether the microphone is open (list.md Phase 13).

      It sits in this row rather than in the header because the header is what mini takes away,
      and mini is the headset's normal state. "Continuous capture with no visible state is the
      thing a user is right to distrust" does not become less true at a metre — so the indicator
      lives in the one region both surfaces show in both modes.

      Docked left of the turn line rather than under it: the two are read at different moments
      and neither should push the other around as it changes length.
    -->
    <DockPanel x:Name="StatusRow" DockPanel.Dock="Bottom" Margin="0,10,0,0">

      <Border x:Name="MicrophoneRow"
              DockPanel.Dock="Left"
              IsVisible="{Binding MicrophoneVisible}"
              Margin="0,0,10,0"
              Padding="7,2"
              CornerRadius="3"
              VerticalAlignment="Center"
              Background="{DynamicResource D47.SurfaceAlt}"
              BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <!--
            A microphone, drawn rather than typed, for the reason the help mark already is: a
            glyph taken from a font is whatever weight that font happens to have, and it hangs
            off a baseline instead of sitting in the middle of its box. A 24-unit coordinate
            space scaled into a 13-pixel box lines up with the text beside it by construction.

            Filled or hollow is the state, not just the colour, because a Commander glancing at
            this in a headset is reading a shape before they read a hue - and because a colour
            difference alone is not a difference for everybody.
          -->
          <Path x:Name="MicrophoneGlyph"
                Width="13" Height="13"
                VerticalAlignment="Center"
                Stretch="Uniform"
                StrokeThickness="2"
                StrokeLineCap="Round"
                StrokeJoin="Round"
                Data="M 12,3 A 3,3 0 0 1 15,6 L 15,11 A 3,3 0 0 1 9,11 L 9,6 A 3,3 0 0 1 12,3 Z
                      M 5.5,10.5 A 6.5,6.5 0 0 0 18.5,10.5 M 12,17 L 12,21" />
          <TextBlock x:Name="MicrophoneLabel"
                     VerticalAlignment="Center"
                     FontSize="{StaticResource D47.Type.Small}" />
        </StackPanel>
      </Border>

      <!--
        Which assigned HOTAS switches currently sit against the game's state (list.md Phase 21).
        In this row rather than in the banners, and the difference is the whole point: mini hides
        the banners and mini is the headset's normal state, so a switch annunciator up there
        would be invisible exactly where a Commander cannot see their own switches either.

        Docked right, so it never pushes the microphone indicator around — the two change on
        completely different clocks.
      -->
      <Border x:Name="SwitchRow"
              DockPanel.Dock="Right"
              IsVisible="{Binding SwitchesVisible}"
              Margin="10,0,0,0"
              Padding="7,2"
              CornerRadius="3"
              VerticalAlignment="Center"
              Background="{DynamicResource D47.SurfaceAlt}"
              BorderBrush="{DynamicResource D47.Accent}"
              BorderThickness="1">
        <TextBlock x:Name="SwitchText"
                   Text="{Binding SwitchesText}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource D47.Type.Small}"
                   Foreground="{DynamicResource D47.Accent}" />
      </Border>

      <!--
        One line of provenance per turn: which path answered, at what effort, for what.

        The figures behind it live in a dialog rather than on the line. Eleven numbers on one
        row beside a running game is a wall a Commander reads none of; the ones that answer
        "did that work" stay here and the rest are a click away. The link is docked so the line
        wraps against it rather than pushing it off the row.
      -->
      <Button x:Name="TurnDetails"
              DockPanel.Dock="Right"
              Content="Details"
              IsVisible="False"
              Margin="8,0,0,0"
              Padding="6,1"
              MinWidth="0"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand"
              FontSize="{StaticResource D47.Type.Secondary}"
              Foreground="{DynamicResource D47.Accent}"
              ToolTip.Tip="Tokens, cost, and what this has come to over time"
              Click="OnTurnDetailsClick" />
      <TextBlock x:Name="TurnLine"
                 Text="{Binding TurnLine}"
                 VerticalAlignment="Center"
                 FontFamily="Cascadia Mono,Consolas,monospace"
                 FontSize="{StaticResource D47.Type.Secondary}"
                 Foreground="{DynamicResource D47.TextMuted}"
                 TextWrapping="Wrap" />
    </DockPanel>

    <!--
      Which page of the transcript this surface is showing. On the view rather than on the view
      model, for the same reason PanelMode is: both surfaces bind one model, so a page held
      there would send the headset to the log file the moment the window went to it. The model
      owns the content; how much of it a given surface shows is that surface's business.
    -->
    <DockPanel x:Name="TabStrip" DockPanel.Dock="Top" Margin="0,16,0,0">

      <!--
        One search affordance for the surface, on the tab that is selected — not four features
        bolted to four pages (list.md Phase 12). What a match does differs by page and that
        difference is the design: the transcript pages highlight and step, and Settings filters,
        so the count and the steppers are hidden where they would mean nothing.

        Hidden until a host enables it, which only the desktop window does. Mini shows no strip
        and the headset has no keyboard, and a search box the Commander cannot type into is
        worse than no search at all.
      -->
      <StackPanel x:Name="SearchRow"
                  DockPanel.Dock="Right"
                  Orientation="Horizontal"
                  Spacing="6"
                  IsVisible="False"
                  VerticalAlignment="Bottom"
                  Margin="12,0,0,4">
        <!--
          One affordance for the whole page as it is currently shown (list.md Phase 19, "Copy
          log"). Beside the search box because both are about the page rather than about the
          conversation, and because this is the row a Commander looks at when they are reading
          rather than talking.

          The text is selectable and Ctrl+C already works on a selection; this is the case that
          is tedious by hand — several hundred lines of a log, to paste into an issue.
        -->
        <!-- Centred like everything else in this row. Without it the button takes the strip's
             full height and its label sits wherever the stack put it, which beside a 28-pixel
             search box reads as one control hanging lower than its neighbours. -->
        <Button x:Name="CopyButton"
                Height="28"
                VerticalAlignment="Center"
                Padding="10,0"
                FontSize="{StaticResource D47.Type.Secondary}"
                Content="Copy"
                Click="OnCopyClick" />
        <!--
          The clear affordance sits inside the field, not beside it. Another sibling in this
          StackPanel would sit outside the border and read as a fourth button in a row that
          already has Copy and the two steppers, rather than as part of the box it empties.

          U+00D7, the multiplication sign, and deliberately not the letter x — the same reason
          the steppers above are U+2039 and U+203A rather than angle brackets.

          Hidden until there is something to clear, or it is a control that does nothing for
          most of the time a Commander can see it.
        -->
        <!--
          Body, not Secondary. A field the Commander types into is not supporting text, and at
          13 beside a page of 14 it read as a smaller-than-everything control rather than as a
          quieter one — which is the exact drift TypeScale exists to stop.
        -->
        <TextBox x:Name="SearchInput"
                 Width="200"
                 Height="28"
                 Padding="8,3"
                 FontSize="{StaticResource D47.Type.Body}"
                 VerticalContentAlignment="Center"
                 PlaceholderText="Search this page"
                 TextChanged="OnSearchChanged"
                 KeyDown="OnSearchKeyDown">
          <TextBox.InnerRightContent>
            <Button x:Name="SearchClear"
                    Content="&#x00D7;"
                    Padding="6,0"
                    MinWidth="0"
                    Margin="0,0,2,0"
                    IsVisible="False"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource D47.Type.Body}"
                    Foreground="{DynamicResource D47.TextMuted}"
                    Cursor="Hand"
                    ToolTip.Tip="Clear the search (Esc)"
                    AutomationProperties.Name="Clear the search"
                    Click="OnSearchClearClick" />
          </TextBox.InnerRightContent>
        </TextBox>
        <TextBlock x:Name="SearchCount"
                   VerticalAlignment="Center"
                   IsVisible="False"
                   FontSize="{StaticResource D47.Type.Secondary}"
                   Foreground="{DynamicResource D47.TextMuted}" />
        <Button x:Name="SearchPrevious"
                Content="&#x2039;"
                Padding="8,0"
                MinWidth="0"
                Height="28"
                IsVisible="False"
                FontSize="{StaticResource D47.Type.Body}"
                ToolTip.Tip="Previous match (Shift+Enter)"
                Click="OnSearchPreviousClick" />
        <Button x:Name="SearchNext"
                Content="&#x203A;"
                Padding="8,0"
                MinWidth="0"
                Height="28"
                IsVisible="False"
                FontSize="{StaticResource D47.Type.Body}"
                ToolTip.Tip="Next match (Enter)"
                Click="OnSearchNextClick" />
      </StackPanel>

      <StackPanel x:Name="TranscriptTabs"
                  Orientation="Horizontal"
                  VerticalAlignment="Bottom">
      <!--
        No GroupName, deliberately. Avalonia groups named radio buttons across the whole
        application rather than within a tree, and this view is instantiated twice - once by the
        window, once by the headset overlay. A shared name put both strips in one group, so the
        overlay's tabs unchecked the window's as they were built, and the window opened with no
        tab highlighted until it was clicked. Nameless, they group by their parent panel, which
        is one strip per surface - which is what a tab strip is.
      -->
      <RadioButton x:Name="ConversationTab"
                   Theme="{StaticResource D47.Tab}"
                   IsChecked="True"
                   Content="Conversation"
                   IsCheckedChanged="OnPageTabChecked" />
      <RadioButton x:Name="TechnicalTab"
                   Theme="{StaticResource D47.Tab}"
                   Content="Technical"
                   IsCheckedChanged="OnPageTabChecked" />
      <!--
        This tab reads a file off disk before it can show anything, so it carries the glyph that
        says so. On the tab, because the affordance that was touched is the thing that shows it:
        a Commander who clicked here does not look elsewhere (list.md Phase 12). It is on the
        panel rather than on the window, so the headset's copy of this view gets it too.
      -->
      <RadioButton x:Name="LogTab"
                   Theme="{StaticResource D47.Tab}"
                   IsCheckedChanged="OnPageTabChecked">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Text="Log file" VerticalAlignment="Center" />
          <controls:BusyGlyph x:Name="LogBusy"
                              IsVisible="False"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource D47.Accent}" />
        </StackPanel>
      </RadioButton>
      <!--
        Hidden until a host says otherwise, and only the desktop window ever does. The headset
        renders this same view, and a 1180-pixel nav column at a metre is not a settings surface
        so much as a wall - so the tab is absent there rather than present and asking to be
        remembered about (list.md Phase 12).
      -->
      <RadioButton x:Name="SettingsTab"
                   Theme="{StaticResource D47.Tab.Settings}"
                   IsVisible="False"
                   Content="Settings"
                   IsCheckedChanged="OnPageTabChecked" />
      </StackPanel>

    </DockPanel>

    <!--
      One slot, two pages. The transcript and the settings surface occupy the same place under
      the strip and are swapped by which tab is checked, which is what makes settings a page of
      this window rather than a second window.
    -->
    <Panel>
      <!-- Top-left corner square, because a tab is sitting on it. Rounding it there would leave
           a visible notch between the first tab and the panel it belongs to. -->
      <Border x:Name="TranscriptPane"
              Background="{DynamicResource D47.Surface}"
              BorderBrush="{DynamicResource D47.Border}"
              BorderThickness="1"
              CornerRadius="0,4,4,4"
              Padding="14"
              Margin="0,0,0,0">
        <Panel>
          <ScrollViewer x:Name="TranscriptScroller" ScrollChanged="OnTranscriptScrolled">
            <!-- No Text binding: the content is written as runs from code-behind, because a
                 marked line - the panel noting that the core changed - is drawn differently from
                 the conversation around it, and one string cannot carry that.

                 SelectableTextBlock rather than TextBlock, and that is the whole of "the live log
                 is selectable and copyable" (list.md Phase 19): drag-selection across the text
                 and Ctrl+C are the control's own, so there is no workflow to invent. The item
                 says so itself - "if it is free due to the nature of the controls being used,
                 then don't invent a workflow that's unneeded". SelectableTextBlockTests asserts
                 it stays that way. -->
            <SelectableTextBlock x:Name="Transcript"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="{StaticResource D47.Type.Body}"
                                 TextWrapping="Wrap" />
          </ScrollViewer>

          <!--
            Floating over the transcript rather than docked beside it, because it is about where
            the reader is rather than about the page: it appears only when there is something
            below the fold and takes no layout when there is not (list.md Phase 19, "Follow the
            live log, or stop following it").

            Hidden while following, which is the state a panel beside a running game is in
            almost all the time. A permanent "jump to latest" on a view that is already at the
            latest is a control that does nothing, sitting over the text it does nothing to.
          -->
          <Button x:Name="FollowButton"
                  IsVisible="False"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,14,10"
                  Padding="10,5"
                  CornerRadius="14"
                  FontSize="{StaticResource D47.Type.Secondary}"
                  Background="{DynamicResource D47.SurfaceAlt}"
                  BorderBrush="{DynamicResource D47.Border}"
                  BorderThickness="1"
                  ToolTip.Tip="Scroll to the newest line and follow it again"
                  Click="OnFollowClick" />
        </Panel>
      </Border>

      <!--
        Filled on first selection by whatever the host handed to EnableSettings, and never at
        all on a surface that was handed nothing. The fill is D47.Background rather than the
        transcript's D47.Surface because the cards inside it are Surface, and a card the same
        colour as the page it sits on is not a card - which is also why the Settings tab has a
        control theme of its own for the join.
      -->
      <Border x:Name="SettingsPane"
              IsVisible="False"
              ClipToBounds="True"
              Background="{DynamicResource D47.Background}"
              BorderBrush="{DynamicResource D47.Border}"
              BorderThickness="1"
              CornerRadius="0,4,4,4" />
    </Panel>

  </DockPanel>
</UserControl>
