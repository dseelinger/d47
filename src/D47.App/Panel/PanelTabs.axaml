<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:D47.App.Controls">

  <!--
    A tab, and it has to read as one rather than as a button or a link.

    Skewed 12px on both edges and sitting on the rule, the way every strip in the kit does.
    Selected is a solid Accent fill with Background-colour ink; unselected is Accent ink on the
    faint Accent fill (#273).

    Built on RadioButton rather than on Buttons and a hand-rolled selected flag, because
    mutually-exclusive selection, keyboard arrows and the accessibility role all come with it.
  -->
  <ControlTheme x:Key="D47.Tab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="avares://d47/Assets/Fonts/SairaSemiCondensed-Regular.ttf#Saira Semi Condensed" />
    <Setter Property="FontSize" Value="{StaticResource D47.Type.Body}" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource D47.Accent}" />
    <Setter Property="Padding" Value="18,7" />
    <Setter Property="Margin" Value="0,0,3,0" />

    <Setter Property="Template">
      <ControlTemplate>
        <controls:ChamferedBorder x:Name="Shape" Skew="12" Background="{DynamicResource D47.FillLow}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </controls:ChamferedBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ controls|ChamferedBorder#Shape">
      <Setter Property="Background" Value="{DynamicResource D47.FillHigh}" />
    </Style>

    <!-- Unselected: Accent ink on the faint fill. No glow (#285) — the label sits on D47.FillLow,
         an Accent tint, and a glow shows only where the area around it is dark. -->

    <!-- The current tab: a solid fill rather than a muted one, findable at a glance from a
         metre away, which is the whole job of a selected tab in a headset. -->
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style Selector="^ /template/ controls|ChamferedBorder#Shape">
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        <Setter Property="Effect" Value="{DynamicResource D47.Bloom.Fill}" />
      </Style>
    </Style>

  </ControlTheme>

  <!--
    One crumb of the breadcrumb (list.md Phase 25, "Drill in, and find your way back").

    It is both the back affordance and the you-are-here, because a headset has no title bar to
    orient by and losing your place is expensive when you cannot glance at a second monitor.
    So every crumb but the last is pressable and the last one is not: the last crumb is where
    you are, and a control that does nothing is a control that costs a press to learn that.

    A button rather than a link, and quiet rather than accented, because the row is read as a
    trail rather than as a set of choices - the accent in this region belongs to the tab.
  -->
  <ControlTheme x:Key="D47.Crumb" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="avares://d47/Assets/Fonts/SairaSemiCondensed-Regular.ttf#Saira Semi Condensed" />
    <Setter Property="FontSize" Value="{StaticResource D47.Type.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource D47.Accent}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinWidth" Value="0" />

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource D47.SurfaceAlt}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource D47.Accent}" />
    </Style>

    <!-- Where you are. Disabled rather than drawn as a label, so the control keeps its metrics
         and the row does not shift by a pixel as the trail grows and shrinks. -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Foreground" Value="{DynamicResource D47.Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
  </ControlTheme>

</ResourceDictionary>
