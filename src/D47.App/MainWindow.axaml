<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panel="clr-namespace:D47.App.Panel"
        xmlns:windowing="clr-namespace:D47.App.Windowing"
        x:Class="D47.App.MainWindow"
        Title="Directive 47"
        Icon="/Assets/directive-47.ico"
        Width="820" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource D47.Bg}"
        Foreground="{DynamicResource D47.White}">

  <!-- The window is the desktop host for the panel, and nothing more. Everything the panel
       shows lives in PanelView, which the VR overlay instantiates for itself against the same
       view model — and which, since Phase 12, carries the settings surface
       as one of its pages rather than handing it to a second window. -->
  <Grid>
    <panel:PanelView x:Name="Panel" />
    <!-- Modal dialogs, over the panel and inside the zoom (#521). -->
    <windowing:ModalHost x:Name="Modals" />
  </Grid>
</Window>
