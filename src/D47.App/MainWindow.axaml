<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="D47.App.MainWindow"
        Title="d47"
        Width="820" Height="640"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Spacing="2">
      <TextBlock Text="d47" FontSize="30" FontWeight="Light" />
      <TextBlock Text="Directive 47 — Optimize Inferior Systems" FontSize="12" Opacity="0.6" />
      <TextBlock x:Name="VersionLine" FontSize="11" Opacity="0.35" />
    </StackPanel>

    <!-- Settings that failed to load are said out loud, not swallowed. -->
    <Border x:Name="ErrorBanner"
            DockPanel.Dock="Top"
            IsVisible="False"
            Margin="0,14,0,0"
            Padding="12"
            CornerRadius="4"
            Background="#33FF5555"
            BorderBrush="#88FF5555"
            BorderThickness="1">
      <SelectableTextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <!-- Hidden until a background check finds a newer release; never blocks startup. -->
    <Border x:Name="UpdateBanner"
            DockPanel.Dock="Top"
            IsVisible="False"
            Margin="0,14,0,0"
            Padding="12"
            CornerRadius="4"
            Background="#332288FF"
            BorderBrush="#882288FF"
            BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNowClick" />
          <Button x:Name="UpdateLaterButton" Content="Later" Click="OnUpdateLaterClick" />
        </StackPanel>
        <TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Ask box. Enter sends; the button is for discoverability. -->
    <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <DockPanel>
        <Button x:Name="AskButton"
                DockPanel.Dock="Right"
                Content="Ask"
                Margin="8,0,0,0"
                Padding="18,6"
                Click="OnAskClick" />
        <TextBox x:Name="AskBox"
                 Watermark="Ask d47 something — try &quot;where am I&quot; or &quot;what's your status&quot;"
                 KeyDown="OnAskBoxKeyDown" />
      </DockPanel>
    </Border>

    <!-- One line of provenance per turn: which path answered, at what effort, for what. -->
    <TextBlock x:Name="TurnLine"
               DockPanel.Dock="Bottom"
               Margin="0,10,0,0"
               FontFamily="Cascadia Mono,Consolas,monospace"
               FontSize="11"
               Opacity="0.55"
               TextWrapping="Wrap" />

    <Border Background="#14FFFFFF" CornerRadius="4" Padding="14" Margin="0,16,0,0">
      <ScrollViewer x:Name="TranscriptScroller">
        <SelectableTextBlock x:Name="Transcript"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             FontSize="12"
                             TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

  </DockPanel>
</Window>
