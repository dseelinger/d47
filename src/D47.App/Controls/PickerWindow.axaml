<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:D47.App.Controls"
        x:Class="D47.App.Controls.PickerWindow"
        Width="520" Height="420"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource D47.Surface}"
        Foreground="{DynamicResource D47.Text}">

  <Border BorderBrush="{DynamicResource D47.Border}" BorderThickness="1" Padding="14">
    <DockPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
        <TextBlock x:Name="PromptText" FontSize="{StaticResource D47.Type.Subheading}" Foreground="{DynamicResource D47.Accent}" />
        <TextBlock x:Name="HelpText"
                   FontSize="{StaticResource D47.Type.Secondary}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource D47.TextMuted}" />
        <!--
          What pressing a play glyph costs, said once for the whole list rather than on every row
          (change-requests.md 18). The number itself is Phase 11's and is not negotiable: an
          ElevenLabs audition spends the Commander's money, and they have to be able to see that
          without hovering anything. What changed is that it is a sentence about the list instead
          of a label on a button.
        -->
        <TextBlock x:Name="AuditionNote"
                   IsVisible="False"
                   Margin="0,4,0,0"
                   FontSize="{StaticResource D47.Type.Secondary}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource D47.TextMuted}" />
      </StackPanel>

      <TextBox x:Name="FilterBox"
               DockPanel.Dock="Top"
               Margin="0,0,0,8"
               KeyDown="OnFilterKeyDown"
               TextChanged="OnFilterChanged" />

      <!--
        The structured half of the filter (#146). A voice carries its gender as data and the label
        merely renders it, so asking for the women asks the field rather than hoping a word turns up
        in a string - which is the mistake underneath "male" having listed every female voice.

        Absent rather than present-and-pointless where the choices carry no such field: a microphone
        picker has no facet at all, the same way it has no play glyph.
      -->
      <StackPanel x:Name="FacetPanel"
                  DockPanel.Dock="Top"
                  Orientation="Horizontal"
                  Spacing="8"
                  IsVisible="False"
                  Margin="0,0,0,8">
        <TextBlock x:Name="FacetLabel"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource D47.Type.Secondary}"
                   Foreground="{DynamicResource D47.TextMuted}" />
        <ComboBox x:Name="FacetBox"
                  MinWidth="150"
                  SelectionChanged="OnFacetChanged" />
      </StackPanel>

      <!-- The fail-soft contract, stated rather than implied: with nothing to offer, the box
           above is still the answer. -->
      <TextBlock x:Name="EmptyHint"
                 DockPanel.Dock="Bottom"
                 IsVisible="False"
                 Margin="0,8,0,0"
                 FontSize="{StaticResource D47.Type.Secondary}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource D47.TextMuted}" />

      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="0,10,0,0">
        <Button Content="Cancel" Click="OnCancelClick" />
        <Button x:Name="AcceptButton" Content="Use this" Click="OnAcceptClick" IsDefault="True" />
      </StackPanel>

      <!-- Its own row, stretched to the list rather than sized to its content. What goes in it
           is a resolved default - "(the system default - Microphone (Virtual Desktop Audio))" -
           and in one right-aligned row with the other two it grew the row past the window and
           pushed Cancel and Use this off the left edge, which left the picker with no visible
           way out. Stretched and trimmed it cannot do that whatever the string turns out to be;
           the pointer gets the whole of it. -->
      <Button x:Name="DefaultButton"
              DockPanel.Dock="Bottom"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Margin="0,10,0,0"
              IsVisible="False"
              Click="OnUseDefaultClick">
        <TextBlock x:Name="DefaultButtonText" TextTrimming="CharacterEllipsis" />
      </Button>

      <!--
        Hearing it is not choosing it (list.md Phase 19), and since 0.23.0 that is a glyph on the
        row rather than a button under the list (change-requests.md 18). The control that plays a
        voice is beside the voice it plays, which is what every list of audio a Commander has ever
        met does, and it takes the selection out of the question entirely.

        A press rather than a hover or a selection-changed: on a paid provider every one of these
        is a synthesis request billed by the character, so walking the list with the arrow keys
        must cost nothing at all.
      -->
      <ListBox x:Name="Choices"
               Background="{DynamicResource D47.SurfaceAlt}"
               BorderBrush="{DynamicResource D47.Border}"
               BorderThickness="1"
               DoubleTapped="OnChoiceDoubleTapped"
               KeyDown="OnFilterKeyDown">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="controls:PickerChoice">
            <DockPanel>
              <!--
                Docked before the text so the text takes what is left, and absent rather than
                inert on a row that offers nothing to hear - a microphone picker has no play
                control at all.
              -->
              <Button DockPanel.Dock="Right"
                      IsVisible="{Binding CanPlay}"
                      IsEnabled="{Binding Playable}"
                      ToolTip.Tip="{Binding Why}"
                      AutomationProperties.Name="{Binding ActionName}"
                      Click="OnPlayClick"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="6,0"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      Cursor="Hand">
                <!-- One 24x24 coordinate space for both glyphs, so the square and the triangle
                     are the same size on screen. A Path asked to stretch scales against its own
                     bounds, and these two have different ones. -->
                <Viewbox Width="15" Height="15">
                  <Canvas Width="24" Height="24">
                    <Path Data="{Binding Glyph}" Fill="{DynamicResource D47.TextMuted}" />
                  </Canvas>
                </Viewbox>
              </Button>
              <TextBlock Text="{Binding Text}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </DockPanel>
  </Border>
</Window>
