<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    The same five sizes TypeScale.cs declares, for the views authored in markup. Two
    declarations of one scale is one more than ideal, and the alternative is worse: x:Static
    against a const double works in Avalonia markup only through a markup extension that does
    not survive the compiled-binding path every view here uses, and half the sizes are set from
    code-behind anyway. TypeScaleTests asserts the two agree, so they cannot drift the way the
    forty-six literals these replaced did.

    Body is 14 because that is what an unstyled Avalonia control renders at. Everything else is
    positioned relative to it.
  -->
  <sys:Double x:Key="D47.Type.Heading">20</sys:Double>
  <sys:Double x:Key="D47.Type.Subheading">16</sys:Double>
  <sys:Double x:Key="D47.Type.Body">14</sys:Double>
  <sys:Double x:Key="D47.Type.Secondary">13</sys:Double>
  <sys:Double x:Key="D47.Type.Small">12</sys:Double>

</ResourceDictionary>
