<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panel="clr-namespace:D47.App.Panel">

  <!--
    The HUD dress for the three controls that appear everywhere and had no d47 look of their
    own: Button, ToggleSwitch and ListBoxItem's selected row. Squared corners throughout — the
    dress carries no rounded shape (#273).
  -->
  <Styles.Resources>

    <!--
      Secondary by default: Accent ink on a faint Accent fill, with the rule as a border. A
      button that wants the bolder primary treatment opts in with Classes="primary".
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Body}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Foreground" Value="{DynamicResource D47.Accent}" />
      <Setter Property="Background" Value="{DynamicResource D47.FillLow}" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Shape"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#Shape">
        <Setter Property="Background" Value="{DynamicResource D47.FillHigh}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource D47.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
      </Style>

      <!-- Primary: solid Accent, ink the colour of the background it sits on. -->
      <Style Selector="^.primary">
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Background}" />
        <Setter Property="BorderThickness" Value="0" />

        <!-- The solid fill's own glow (#281, recalibrated #285), off the disabled state along with the fill itself. -->
        <Style Selector="^:not(:disabled) /template/ Border#Shape">
          <Setter Property="Effect" Value="{DynamicResource D47.Bloom.Fill}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Shape">
          <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource D47.TextMuted}" />
        </Style>
      </Style>
    </ControlTheme>

    <!-- Square track, square knob — no thumb animation, since every switch in the app toggles on a tap. -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track"
                  Width="62"
                  Height="32"
                  Background="{DynamicResource D47.Background}"
                  BorderBrush="{DynamicResource D47.Rule}"
                  BorderThickness="1">
            <Panel>
              <!-- Required by ToggleSwitch itself but not otherwise used — this template
                   toggles on a tap, not a drag, so the knob below carries the whole visual. -->
              <Panel x:Name="PART_MovingKnobs" Width="0" Height="0" IsHitTestVisible="False" />
              <Border x:Name="Knob"
                      Width="24"
                      Height="24"
                      Margin="4"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource D47.Accent}"
                      Opacity="0.55" />
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- On: the solid Accent knob moves to the right, so the switch reads by position, not only by brightness. -->
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource D47.FillLow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Accent}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Knob">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Effect" Value="{DynamicResource D47.Bloom.Fill}" />
      </Style>
    </ControlTheme>

    <!--
      2 to 4 fixed choices, adjacent in one row (#274). The chosen segment is a solid Accent block
      with Background-colour ink; the rest are Accent ink on no fill. App-wide rather than scoped
      to the panel, since a desktop-only window (SwitchWindow, MacroWindow, and the rest) needs the
      same look and carries no merge of PanelTabs.axaml.

      Built on RadioButton for the mutual exclusion, arrow-key movement and accessibility role that
      come with it, the same reason D47.Tab is.
    -->
    <ControlTheme x:Key="D47.Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="avares://d47/Assets/Fonts/SairaSemiCondensed-Regular.ttf#Saira Semi Condensed" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource D47.Accent}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      <Setter Property="BorderThickness" Value="1" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Shape"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#Shape">
        <Setter Property="Background" Value="{DynamicResource D47.FillLow}" />
      </Style>

      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource D47.Background}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style Selector="^ /template/ Border#Shape">
          <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        </Style>
      </Style>
    </ControlTheme>

    <!--
      The highlighted row of a list: a bar at the left edge and a fill. A highlight is not a choice,
      so nothing here reads as committed (#274). 40 tall, so a ray at a metre lands on it.
    -->
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="3,*">
            <Border x:Name="Bar" Grid.Column="0" Background="Transparent" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Background="Transparent" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <!-- The selected row's own glow (#281, recalibrated #285), behind the leading bar rather than the fill beside it. -->
      <Style Selector="^:selected /template/ Border#Bar">
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        <Setter Property="Effect" Value="{DynamicResource D47.Bloom.Fill}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource D47.FillHigh}" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <!--
    The headset's stronger reading of the solid-fill glow (#285): a glow shows only where the
    area around it is dark, and the headset is read from further away than the desktop window
    is. Declared after the base styles above, so it wins for the elements it matches.
  -->
  <Style Selector="panel|PanelView.headset Button.primary:not(:disabled) /template/ Border#Shape">
    <Setter Property="Effect" Value="{DynamicResource D47.Bloom.Fill.Headset}" />
  </Style>
  <Style Selector="panel|PanelView.headset ListBoxItem:selected /template/ Border#Bar">
    <Setter Property="Effect" Value="{DynamicResource D47.Bloom.Fill.Headset}" />
  </Style>
</Styles>
