<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:D47.App.Controls"
        xmlns:theming="clr-namespace:D47.App.Theming">

  <!--
    The HUD dress for the controls that appear everywhere and had no d47 look of their own:
    Button, ToggleSwitch, the choice controls and ListBoxItem. Squared corners throughout — the
    dress carries no rounded shape (#273).
  -->
  <Styles.Resources>

    <!--
      Every button is a flat Tile with A ink in uppercase Saira: solid A with Knock ink on hover,
      keyboard focus or press, Slab with Grey2 ink when disabled. No outline, corner or glow.
      "primary" and "quiet" draw as the default; "destructive" swaps A for Red, with White ink on
      the solid fill.
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Secondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="20,11" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource D47.A}" />
      <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Shape"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content, Converter={x:Static theming:Capitals.Text}}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource D47.Slab}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey2}" />
      </Style>

      <Style Selector="^.destructive">
        <Setter Property="Foreground" Value="{DynamicResource D47.Red}" />
      </Style>
      <Style Selector="^.destructive:pointerover">
        <Setter Property="Background" Value="{DynamicResource D47.Red}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      </Style>
      <Style Selector="^.destructive:focus-visible">
        <Setter Property="Background" Value="{DynamicResource D47.Red}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      </Style>
      <Style Selector="^.destructive:pressed">
        <Setter Property="Background" Value="{DynamicResource D47.Red}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      </Style>
      <Style Selector="^.destructive:disabled">
        <Setter Property="Background" Value="{DynamicResource D47.Slab}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey2}" />
      </Style>
    </ControlTheme>

    <!--
      A button whose only content is a glyph: a 34-square Tile holding an A glyph, centred in a hit
      target of at least 44 x 44. Hover or keyboard focus turns the tile solid A with a Knock glyph and
      opens a label flush beside it naming the button, taken from AutomationProperties.Name, so every
      glyph button must set one. Disabled, the glyph is Grey2 and no label opens. No glow. Applies to
      RepeatButton, which derives from Button.
    -->
    <ControlTheme x:Key="D47.GlyphButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource D47.A}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Border x:Name="Tile"
                    Width="34"
                    Height="34"
                    Background="{TemplateBinding Background}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="Label"
                   PlacementTarget="{Binding ElementName=Tile}"
                   Placement="Right"
                   IsLightDismissEnabled="False"
                   IsOpen="False">
              <Border Background="{DynamicResource D47.Bg}"
                      BorderBrush="{DynamicResource D47.A}"
                      BorderThickness="1"
                      Height="34"
                      Padding="10,0"
                      IsHitTestVisible="False">
                <TextBlock x:Name="LabelText"
                           Text="{TemplateBinding (AutomationProperties.Name), Converter={x:Static theming:Capitals.Text}}"
                           Foreground="{DynamicResource D47.White}"
                           FontFamily="{StaticResource D47.Font.Chrome}"
                           FontSize="{StaticResource D47.Type.Meta}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </Border>
            </Popup>
          </Panel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>

      <Style Selector="^:pointerover:not(:disabled) /template/ Popup#Label">
        <Setter Property="IsOpen" Value="True" />
      </Style>
      <Style Selector="^:focus-visible:not(:disabled) /template/ Popup#Label">
        <Setter Property="IsOpen" Value="True" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey2}" />
      </Style>
    </ControlTheme>

    <!--
      A stepper's arrow: a Tile cell with an A glyph; solid A with a Knock glyph on hover, focus or
      press; a Grey2 glyph when disabled. No glow. Applies to RepeatButton, which derives from Button.
    -->
    <ControlTheme x:Key="D47.StepperArrow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource D47.A}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Ground"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey2}" />
      </Style>
    </ControlTheme>

    <!--
      Two halves, each naming its own state, so a page of switches reads without checking knob
      position and brightness one at a time (#334). A row that wants no words sets OnContent and
      OffContent to null itself; every other row gets this pair by default.
    -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="OnContent" Value="ON" />
      <Setter Property="OffContent" Value="OFF" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.84" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track"
                  Width="128"
                  Height="42"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource D47.Border}">
            <Grid Margin="3" ColumnDefinitions="*,3,*">
              <!-- Required by ToggleSwitch itself but not otherwise used — this template
                   toggles on a tap, not a drag, so the two halves below carry the whole visual. -->
              <Panel x:Name="PART_MovingKnobs" Width="0" Height="0" IsHitTestVisible="False" />
              <theming:BloomStack x:Name="Glow" Grid.Column="0" Tier="Normal" IsLit="False">
                <Border x:Name="OnHalf" Background="Transparent">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                  <ContentPresenter x:Name="OnText"
                                    Content="{TemplateBinding OnContent}"
                                    Foreground="{DynamicResource D47.TextFaint}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                </Border>
              </theming:BloomStack>
              <Border x:Name="OffHalf" Grid.Column="2" Background="Transparent">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter x:Name="OffText"
                                  Content="{TemplateBinding OffContent}"
                                  Foreground="{DynamicResource D47.TextFaint}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- On: the left half fills Accent, ink the colour of the background it sits on, with the fill's own glow. -->
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      </Style>
      <Style Selector="^:checked /template/ Border#OnHalf">
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
      </Style>
      <Style Selector="^:checked /template/ theming|BloomStack#Glow">
        <Setter Property="IsLit" Value="True" />
      </Style>
      <Style Selector="^:checked /template/ ContentPresenter#OnText">
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>

      <!-- Off: the right half fills Border instead, muted ink on it; the left half stays faint. -->
      <Style Selector="^:not(:checked) /template/ Border#OffHalf">
        <Setter Property="Background" Value="{DynamicResource D47.Border}" />
      </Style>
      <Style Selector="^:not(:checked) /template/ ContentPresenter#OffText">
        <Setter Property="Foreground" Value="{DynamicResource D47.TextMuted}" />
      </Style>
    </ControlTheme>

    <!--
      One option of a Segment: a Tile cell with A ink in uppercase Saira, Tile2 on hover or focus,
      solid A with Knock ink when chosen, Slab with Grey2 ink when disabled. No border and no glow.
      App-wide rather than scoped to the panel, since a desktop-only window (SwitchWindow,
      MacroWindow, and the rest) needs the same look and carries no merge of PanelTabs.axaml.

      Built on RadioButton for the mutual exclusion, arrow-key movement and accessibility role that
      come with it, the same reason D47.Tab is.
    -->
    <ControlTheme x:Key="D47.Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.84" />
      <Setter Property="Foreground" Value="{DynamicResource D47.A}" />
      <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Shape" Background="{TemplateBinding Background}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
              <ContentPresenter.ContentTemplate>
                <DataTemplate x:DataType="x:Object">
                  <TextBlock Text="{Binding Converter={x:Static controls:Segment.Uppercase}}" />
                </DataTemplate>
              </ContentPresenter.ContentTemplate>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource D47.Tile2}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{DynamicResource D47.Tile2}" />
      </Style>

      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey2}" />
        <Setter Property="Background" Value="{DynamicResource D47.Slab}" />
      </Style>
    </ControlTheme>

    <!--
      A plain text row of choices, with no frame or ground (#356): A ink, White on hover or focus,
      White with a 2px A underline when chosen, Grey2 when disabled. Built on RadioButton for the
      same reasons D47.Segment is.
    -->
    <ControlTheme x:Key="D47.TextChoice" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.84" />
      <Setter Property="Foreground" Value="{DynamicResource D47.A}" />
      <Setter Property="Padding" Value="0,2,0,0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />

      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Spacing="3">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" />
            <Border x:Name="Underline" Height="2" Background="Transparent" />
          </StackPanel>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
        <Style Selector="^ /template/ Border#Underline">
          <Setter Property="Background" Value="{DynamicResource D47.A}" />
        </Style>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey2}" />
      </Style>
    </ControlTheme>

    <!--
      A list row, in the same states as the d47-row class below: Tile at rest, Tile2 on hover or
      focus, solid A when selected, Slab when disabled. Foreground is the name's ink, and
      ListRow.NameBrush and ListRow.SecondaryBrush inherit to the content. 44 tall, 2px apart, no
      outline, no bar and no glow.
    -->
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
      <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      <Setter Property="theming:ListRow.NameBrush" Value="{DynamicResource D47.White}" />
      <Setter Property="theming:ListRow.SecondaryBrush" Value="{DynamicResource D47.A}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource D47.Tile2}" />
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="Background" Value="{DynamicResource D47.Tile2}" />
      </Style>

      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource D47.A}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
        <Setter Property="theming:ListRow.NameBrush" Value="{DynamicResource D47.Knock}" />
        <Setter Property="theming:ListRow.SecondaryBrush" Value="{DynamicResource D47.Brown}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource D47.Slab}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey}" />
        <Setter Property="theming:ListRow.NameBrush" Value="{DynamicResource D47.Grey}" />
        <Setter Property="theming:ListRow.SecondaryBrush" Value="{DynamicResource D47.Grey}" />
      </Style>
    </ControlTheme>

    <!--
      Text entry: a 1px A outline on all four sides over no ground, White text, a Grey2 placeholder and
      a Line selection. Focus turns the outline Cyan; disabled turns it Grey2. PART_TextPresenter's own caret is drawn
      transparent; a BlockCaret overlay tracks its caret position and draws the 9x21 Accent block
      instead (#350). The template keeps Fluent's own parts — PART_TextPresenter, the two
      placeholder TextBlocks, PART_ScrollViewer — so selection and the floating placeholder still
      work; only the brushes, sizing and the corner radius are d47's.
    -->
    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CaretBrush" Value="{DynamicResource D47.A}" />
      <Setter Property="CaretBlinkInterval" Value="0:0:1.1" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.A}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource D47.Line}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource D47.Grey2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Prose}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Body}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Panel>
              <Border Name="PART_BorderElement"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      MinWidth="{TemplateBinding MinWidth}"
                      MinHeight="{TemplateBinding MinHeight}" />

              <Border Margin="{TemplateBinding BorderThickness}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ContentPresenter Grid.Column="0"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding InnerLeftContent}" />
                  <DockPanel x:Name="PART_InnerDockPanel" Grid.Column="1" Margin="{TemplateBinding Padding}">
                    <TextBlock Name="PART_FloatingPlaceholder"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               IsVisible="False"
                               Text="{TemplateBinding PlaceholderText}"
                               DockPanel.Dock="Top" />

                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                  IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                  AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                  BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                      <Panel>
                        <TextBlock Name="PART_Placeholder"
                                   Foreground="{TemplateBinding PlaceholderForeground}"
                                   Text="{TemplateBinding PlaceholderText}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                              <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>

                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       LineHeight="{TemplateBinding LineHeight}"
                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                       PasswordChar="{TemplateBinding PasswordChar}"
                                       RevealPassword="{TemplateBinding RevealPassword}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="Transparent"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <controls:BlockCaret Target="{Binding ElementName=PART_TextPresenter}"
                                              Brush="{TemplateBinding CaretBrush}"
                                              Interval="{TemplateBinding CaretBlinkInterval}"
                                              IsActive="{TemplateBinding IsFocused}"
                                              IsHitTestVisible="False" />
                      </Panel>
                      <ScrollViewer.Styles>
                        <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                          <Setter Property="Cursor" Value="IBeam" />
                        </Style>
                      </ScrollViewer.Styles>
                    </ScrollViewer>
                  </DockPanel>
                  <ContentPresenter Grid.Column="2"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding InnerRightContent}" />
                </Grid>
              </Border>
            </Panel>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Cyan}" />
      </Style>

      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource D47.Grey}" />
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Grey2}" />
      </Style>

      <Style Selector="^[UseFloatingPlaceholder=true]:not(:empty) /template/ TextBlock#PART_FloatingPlaceholder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <!--
      The border and stepper buttons a NumericUpDown wraps its field in — kept as its own theme
      because NumericUpDown composes an actual ButtonSpinner rather than drawing the spinner
      itself (#289). Square, no fill; the increase/decrease glyphs take D47.GlyphButton, each in a
      44-wide cell, repeating after 400 ms at 8 per second. The dividers are drawn here,
      on the control, so they hold D47.Border regardless of a button's state.
    -->
    <ControlTheme x:Key="D47.NumberSpinner" TargetType="ButtonSpinner">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel>
              <StackPanel Name="PART_SpinnerPanel"
                          DockPanel.Dock="Right"
                          Orientation="Horizontal"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
                <Border Width="1" Background="{DynamicResource D47.Border}" />
                <RepeatButton Name="PART_IncreaseButton"
                              Theme="{StaticResource D47.GlyphButton}"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Content="▲"
                              AutomationProperties.Name="Increase"
                              FontSize="{StaticResource D47.Type.Small}"
                              Width="44"
                              Delay="400"
                              Interval="125"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center" />
                <Border Width="1" Background="{DynamicResource D47.Border}" />
                <RepeatButton Name="PART_DecreaseButton"
                              Theme="{StaticResource D47.GlyphButton}"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Content="▼"
                              AutomationProperties.Name="Decrease"
                              FontSize="{StaticResource D47.Type.Small}"
                              Width="44"
                              Delay="400"
                              Interval="125"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center" />
              </StackPanel>

              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:left">
        <Style Selector="^ /template/ StackPanel#PART_SpinnerPanel">
          <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
      </Style>
    </ControlTheme>

    <!--
      A number field, 46 tall so its spinner cells stay 44, outlined as a text field is: the value in mono, InnerRightContent as the
      unit chip beside it, then the spinner. Focus turns the whole outline Cyan.
    -->
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
      <Setter Property="Foreground" Value="{DynamicResource D47.White}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource D47.Grey2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.A}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Subheading}" />
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <ButtonSpinner Name="PART_Spinner"
                           Theme="{StaticResource D47.NumberSpinner}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           IsTabStop="False"
                           Padding="0"
                           MinWidth="0"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch"
                           AllowSpin="{TemplateBinding AllowSpin}"
                           ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                           ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
              <DockPanel>
                <ContentPresenter Name="PART_Unit"
                                  DockPanel.Dock="Right"
                                  Content="{TemplateBinding InnerRightContent}"
                                  IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBox Name="PART_TextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="{TemplateBinding Padding}"
                         MinWidth="0"
                         MinHeight="0"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         Foreground="{TemplateBinding Foreground}"
                         PlaceholderText="{TemplateBinding PlaceholderText}"
                         PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                         IsReadOnly="{TemplateBinding IsReadOnly}"
                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                         Text="{TemplateBinding Text}"
                         TextAlignment="{TemplateBinding TextAlignment}"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         InnerLeftContent="{Binding InnerLeftContent, RelativeSource={RelativeSource TemplatedParent}}"/>
              </DockPanel>
            </ButtonSpinner>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Cyan}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Grey2}" />
      </Style>
    </ControlTheme>

    <!--
      The Level control's Slider (#352): a 30-tall D47.Rule/D47.FillLow track, centred inside the
      40-tall Track that the 10-wide handle needs so it can overhang 5px top and bottom.
    -->
    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FocusAdorner" Value="{x:Static theming:FocusRing.Template}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid MinHeight="44" VerticalAlignment="Center">
            <Border Height="30"
                    VerticalAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource D47.Rule}"
                    Background="{DynamicResource D47.FillLow}" />
            <Track Name="PART_Track"
                   Height="40"
                   Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton"
                              Theme="{StaticResource D47.SliderFill}"
                              Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton"
                              Background="Transparent"
                              BorderThickness="0"
                              Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Name="thumb" Theme="{StaticResource D47.SliderThumb}" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- The Level's fill: Accent, inset 3px on every side of the 30-tall track, with the high bloom. -->
    <ControlTheme x:Key="D47.SliderFill" TargetType="RepeatButton">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <theming:BloomStack Tier="High">
            <Border Background="{TemplateBinding Background}" />
          </theming:BloomStack>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!--
      The Level's handle: a visible 10-wide D47.AccentInk bar inside a 44-wide transparent hit
      rectangle, so the drawn handle stays the handoff's width while a pointer or VR ray still
      finds it at the minimum interactive target.
    -->
    <ControlTheme x:Key="D47.SliderThumb" TargetType="Thumb">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Rectangle Width="44" Height="44" Fill="Transparent" />
            <theming:BloomStack Tier="High" Width="10" Height="40">
              <Rectangle Fill="{DynamicResource D47.AccentInk}" />
            </theming:BloomStack>
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!--
      Terminal-readout tooltips (#381): opaque fill-3, a 1px rule border, square corners and no
      shadow — Fluent's rounded gray card, replaced everywhere in the app. Delay and placement are
      attached properties on the target control, not the tooltip, so a ControlTheme keyed to ToolTip
      cannot set them; the Style below the Resources block does, once, for every Control.
    -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource D47.FillHigher}" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxWidth" Value="280" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Prose}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Tip}" />
      <Setter Property="Foreground" Value="{DynamicResource D47.Text}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Content="{TemplateBinding Content}"
                               ContentTemplate="{TemplateBinding ContentTemplate}"
                               Padding="{TemplateBinding Padding}"
                               Foreground="{TemplateBinding Foreground}"
                               TextWrapping="Wrap" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

  </Styles.Resources>

  <!--
    Every tooltip's own delay and placement (#381): 600ms to show, opening below and left-aligned
    with the control it explains, 8px away, flipped above by Avalonia's own popup placement when
    that would clip past the window edge. One default for every control rather than a call at every
    site that sets a tip.
  -->
  <Style Selector=":is(Control)">
    <Setter Property="ToolTip.ShowDelay" Value="600" />
    <Setter Property="ToolTip.Placement" Value="BottomEdgeAlignedLeft" />
    <Setter Property="ToolTip.VerticalOffset" Value="8" />
  </Style>

  <!--
    The list-row class (ListRow.Class) for a hand-built Border row: the ListBoxItem states, with
    ListRow.SelectedClass marking the selected row. The row's text follows ListRow.NameBrush and
    ListRow.SecondaryBrush through ListRow.Name and ListRow.Secondary.
  -->
  <Style Selector="Border.d47-row">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="{DynamicResource D47.Tile}" />
    <Setter Property="theming:ListRow.NameBrush" Value="{DynamicResource D47.White}" />
    <Setter Property="theming:ListRow.SecondaryBrush" Value="{DynamicResource D47.A}" />
  </Style>
  <Style Selector="Border.d47-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource D47.Tile2}" />
  </Style>
  <Style Selector="Border.d47-row.selected">
    <Setter Property="Background" Value="{DynamicResource D47.A}" />
    <Setter Property="theming:ListRow.NameBrush" Value="{DynamicResource D47.Knock}" />
    <Setter Property="theming:ListRow.SecondaryBrush" Value="{DynamicResource D47.Brown}" />
  </Style>
  <Style Selector="Border.d47-row:disabled">
    <Setter Property="Background" Value="{DynamicResource D47.Slab}" />
    <Setter Property="theming:ListRow.NameBrush" Value="{DynamicResource D47.Grey}" />
    <Setter Property="theming:ListRow.SecondaryBrush" Value="{DynamicResource D47.Grey}" />
  </Style>

</Styles>
