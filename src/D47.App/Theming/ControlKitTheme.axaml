<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:D47.App.Controls">

  <!--
    The HUD dress for the three controls that appear everywhere and had no d47 look of their
    own: Button, ToggleSwitch and ListBoxItem's selected row. Squared corners throughout — the
    dress carries no rounded shape (#273).
  -->
  <Styles.Resources>

    <!-- The keyboard focus ring every control gets: a 2px Accent outline, 2px clear of the edge (#347). -->
    <ControlTemplate x:Key="D47.FocusAdorner">
      <Rectangle IsHitTestVisible="False"
                 Margin="-3"
                 Stroke="{DynamicResource D47.Accent}"
                 StrokeThickness="2" />
    </ControlTemplate>

    <!--
      Normal by default: ink on no fill, with the rule as a border. A button opts into one of the
      other three weights with Classes — "primary" for the one solid-fill action a surface gets,
      "quiet" for an alternate or an exit, "destructive" for a delete (#337).
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Secondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="2.1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="20,11" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Foreground" Value="{DynamicResource D47.Text}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusAdorner" Value="{StaticResource D47.FocusAdorner}" />
      <Setter Property="Template">
        <ControlTemplate>
          <controls:ChamferedBorder x:Name="Shape"
                                     Background="{TemplateBinding Background}"
                                     BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <!-- The quiet weight's underline, drawn as a dotted rectangle rather than a second clipper. -->
              <Rectangle x:Name="QuietRule"
                         IsVisible="False"
                         Height="1"
                         VerticalAlignment="Bottom"
                         Stroke="{DynamicResource D47.Rule}"
                         StrokeThickness="1"
                         StrokeDashArray="1,1" />
            </Grid>
          </controls:ChamferedBorder>
        </ControlTemplate>
      </Setter>

      <!-- Hover: the border switches from D47.Rule to Accent. -->
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Accent}" />
      </Style>

      <!-- The whole control fades rather than recolours; disabled already refuses pointer input. -->
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.35" />
      </Style>

      <!-- Primary: solid Accent, ink the colour of the background it sits on, one per surface. -->
      <Style Selector="^.primary">
        <Setter Property="FontSize" Value="{StaticResource D47.Type.Subheading}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="2.72" />
        <Setter Property="Padding" Value="34,15" />
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
        <Setter Property="BorderThickness" Value="0" />

        <Style Selector="^ /template/ controls|ChamferedBorder#Shape">
          <Setter Property="Chamfer" Value="0,11,0,0" />
        </Style>

        <!-- The solid fill's own glow (#345), off the disabled state along with the fill itself. -->
        <Style Selector="^:not(:disabled) /template/ controls|ChamferedBorder#Shape">
          <Setter Property="Effect" Value="{DynamicResource D47.Bloom}" />
        </Style>
      </Style>

      <!-- Quiet: no border, muted ink, a dotted rule underline. For alternates and exits. -->
      <Style Selector="^.quiet">
        <Setter Property="Foreground" Value="{DynamicResource D47.TextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,11" />

        <Style Selector="^ /template/ Rectangle#QuietRule">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Hover: the ink switches from TextMuted to Text, the underline from D47.Rule to Accent. -->
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource D47.Text}" />
        </Style>
        <Style Selector="^:pointerover /template/ Rectangle#QuietRule">
          <Setter Property="Stroke" Value="{DynamicResource D47.Accent}" />
        </Style>
      </Style>

      <!-- Destructive: a Danger border and ink, unchanged on hover. For deletes only. -->
      <Style Selector="^.destructive">
        <Setter Property="Foreground" Value="{DynamicResource D47.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Danger}" />
        <Setter Property="Padding" Value="18,11" />

        <Style Selector="^:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource D47.Danger}" />
        </Style>
      </Style>
    </ControlTheme>

    <!--
      Two halves, each naming its own state, so a page of switches reads without checking knob
      position and brightness one at a time (#334). A row that wants no words sets OnContent and
      OffContent to null itself; every other row gets this pair by default.
    -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="OnContent" Value="On" />
      <Setter Property="OffContent" Value="Off" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Small}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track"
                  Width="128"
                  Height="42"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource D47.Border}">
            <Grid Margin="3" ColumnDefinitions="*,3,*">
              <!-- Required by ToggleSwitch itself but not otherwise used — this template
                   toggles on a tap, not a drag, so the two halves below carry the whole visual. -->
              <Panel x:Name="PART_MovingKnobs" Width="0" Height="0" IsHitTestVisible="False" />
              <Border x:Name="OnHalf" Grid.Column="0" Background="Transparent">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter x:Name="OnText"
                                  Content="{TemplateBinding OnContent}"
                                  Foreground="{DynamicResource D47.TextFaint}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
              <Border x:Name="OffHalf" Grid.Column="2" Background="Transparent">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter x:Name="OffText"
                                  Content="{TemplateBinding OffContent}"
                                  Foreground="{DynamicResource D47.TextFaint}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- On: the left half fills Accent, ink the colour of the background it sits on, with the fill's own glow. -->
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      </Style>
      <Style Selector="^:checked /template/ Border#OnHalf">
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
        <Setter Property="Effect" Value="{DynamicResource D47.Bloom}" />
      </Style>
      <Style Selector="^:checked /template/ ContentPresenter#OnText">
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
      </Style>

      <!-- Off: the right half fills Border instead, muted ink on it; the left half stays faint. -->
      <Style Selector="^:not(:checked) /template/ Border#OffHalf">
        <Setter Property="Background" Value="{DynamicResource D47.Border}" />
      </Style>
      <Style Selector="^:not(:checked) /template/ ContentPresenter#OffText">
        <Setter Property="Foreground" Value="{DynamicResource D47.TextMuted}" />
      </Style>
    </ControlTheme>

    <!--
      2 to 4 fixed choices, framed as one group and wrapping rather than clipping past its width
      (#348). The chosen segment is a solid Accent block with Knock ink and the bloom; the rest
      carry no fill and no border of their own. App-wide rather than scoped to the panel, since a
      desktop-only window (SwitchWindow, MacroWindow, and the rest) needs the same look and
      carries no merge of PanelTabs.axaml.

      Built on RadioButton for the mutual exclusion, arrow-key movement and accessibility role that
      come with it, the same reason D47.Tab is.
    -->
    <ControlTheme x:Key="D47.Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Chrome}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.68" />
      <Setter Property="Foreground" Value="{DynamicResource D47.TextFaint}" />
      <Setter Property="Padding" Value="15,9" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Shape" Background="Transparent">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#Shape">
        <Setter Property="Background" Value="{DynamicResource D47.FillHigh}" />
      </Style>

      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource D47.Knock}" />
        <Style Selector="^ /template/ Border#Shape">
          <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
          <Setter Property="Effect" Value="{DynamicResource D47.Bloom}" />
        </Style>
      </Style>
    </ControlTheme>

    <!--
      The highlighted row of a list: a bar at the left edge and a fill. A highlight is not a choice,
      so nothing here reads as committed (#274). 40 tall, so a ray at a metre lands on it.
    -->
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="3,*">
            <Border x:Name="Bar" Grid.Column="0" Background="Transparent" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Background="Transparent" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:selected /template/ Border#Bar">
        <Setter Property="Background" Value="{DynamicResource D47.Accent}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource D47.FillHigh}" />
      </Style>
    </ControlTheme>

    <!--
      Text entry: a ground, no corners, one lit edge on the bottom rather than a box, so a field
      cannot be mistaken for a read-only row (#335). PART_TextPresenter's own caret is drawn
      transparent; a BlockCaret overlay tracks its caret position and draws the 9x21 Accent block
      instead (#350). The template keeps Fluent's own parts — PART_TextPresenter, the two
      placeholder TextBlocks, PART_ScrollViewer — so selection and the floating placeholder still
      work; only the brushes, sizing and the corner radius are d47's.
    -->
    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource D47.AccentInk}" />
      <Setter Property="Background" Value="{DynamicResource D47.FillHigh}" />
      <Setter Property="CaretBrush" Value="{DynamicResource D47.Accent}" />
      <Setter Property="CaretBlinkInterval" Value="0:0:1.1" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.Accent}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource D47.AccentMuted}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource D47.TextFaint}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Panel>
              <Border Name="PART_BorderElement"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      MinWidth="{TemplateBinding MinWidth}"
                      MinHeight="{TemplateBinding MinHeight}" />

              <Border Margin="{TemplateBinding BorderThickness}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ContentPresenter Grid.Column="0"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding InnerLeftContent}" />
                  <DockPanel x:Name="PART_InnerDockPanel" Grid.Column="1" Margin="{TemplateBinding Padding}">
                    <TextBlock Name="PART_FloatingPlaceholder"
                               Foreground="{TemplateBinding PlaceholderForeground}"
                               IsVisible="False"
                               Text="{TemplateBinding PlaceholderText}"
                               DockPanel.Dock="Top" />

                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                  IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                  AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                  BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                      <Panel>
                        <TextBlock Name="PART_Placeholder"
                                   Foreground="{TemplateBinding PlaceholderForeground}"
                                   Text="{TemplateBinding PlaceholderText}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                              <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>

                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       LineHeight="{TemplateBinding LineHeight}"
                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                       PasswordChar="{TemplateBinding PasswordChar}"
                                       RevealPassword="{TemplateBinding RevealPassword}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="Transparent"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <controls:BlockCaret Target="{Binding ElementName=PART_TextPresenter}"
                                              Brush="{TemplateBinding CaretBrush}"
                                              Interval="{TemplateBinding CaretBlinkInterval}"
                                              IsActive="{TemplateBinding IsFocused}"
                                              IsHitTestVisible="False" />
                      </Panel>
                      <ScrollViewer.Styles>
                        <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                          <Setter Property="Cursor" Value="IBeam" />
                        </Style>
                      </ScrollViewer.Styles>
                    </ScrollViewer>
                  </DockPanel>
                  <ContentPresenter Grid.Column="2"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding InnerRightContent}" />
                </Grid>
              </Border>
            </Panel>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="{DynamicResource D47.TextMuted}" />
      </Style>

      <Style Selector="^[UseFloatingPlaceholder=true]:not(:empty) /template/ TextBlock#PART_FloatingPlaceholder">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>

    <!--
      The border and stepper buttons a NumericUpDown wraps its field in — kept as its own theme
      because NumericUpDown composes an actual ButtonSpinner rather than drawing the spinner
      itself (#289). Square, no fill; the increase/decrease glyphs draw in Accent, each in a
      40-wide cell behind a D47.Border rule, repeating after 400 ms at 8 per second.
    -->
    <ControlTheme x:Key="D47.NumberSpinner" TargetType="ButtonSpinner">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <DockPanel>
              <StackPanel Name="PART_SpinnerPanel"
                          DockPanel.Dock="Right"
                          Orientation="Horizontal"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
                <RepeatButton Name="PART_IncreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Content="▲"
                              FontSize="{StaticResource D47.Type.Small}"
                              Foreground="{DynamicResource D47.Accent}"
                              Background="Transparent"
                              BorderBrush="{DynamicResource D47.Border}"
                              BorderThickness="1,0,0,0"
                              CornerRadius="0"
                              Padding="0"
                              Width="40"
                              Delay="400"
                              Interval="125"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center" />
                <RepeatButton Name="PART_DecreaseButton"
                              IsTabStop="{TemplateBinding IsTabStop}"
                              Content="▼"
                              FontSize="{StaticResource D47.Type.Small}"
                              Foreground="{DynamicResource D47.Accent}"
                              Background="Transparent"
                              BorderBrush="{DynamicResource D47.Border}"
                              BorderThickness="1,0,0,0"
                              CornerRadius="0"
                              Padding="0"
                              Width="40"
                              Delay="400"
                              Interval="125"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center" />
              </StackPanel>

              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:left">
        <Style Selector="^ /template/ StackPanel#PART_SpinnerPanel">
          <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style Selector="^ /template/ RepeatButton">
          <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
      </Style>
    </ControlTheme>

    <!--
      A number field, 44 tall in a D47.Rule frame: the value in mono, InnerRightContent as the
      unit chip beside it, then the spinner above. Focus underlines the value cell only.
    -->
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
      <Setter Property="Foreground" Value="{DynamicResource D47.AccentInk}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource D47.TextMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource D47.Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource D47.Font.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource D47.Type.Subheading}" />
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <ButtonSpinner Name="PART_Spinner"
                           Theme="{StaticResource D47.NumberSpinner}"
                           BorderBrush="{TemplateBinding BorderBrush}"
                           BorderThickness="{TemplateBinding BorderThickness}"
                           IsTabStop="False"
                           Padding="0"
                           MinWidth="0"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch"
                           AllowSpin="{TemplateBinding AllowSpin}"
                           ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                           ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
              <DockPanel>
                <ContentPresenter Name="PART_Unit"
                                  DockPanel.Dock="Right"
                                  Content="{TemplateBinding InnerRightContent}"
                                  IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBox Name="PART_TextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="{TemplateBinding Padding}"
                         MinWidth="0"
                         MinHeight="0"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         Foreground="{TemplateBinding Foreground}"
                         PlaceholderText="{TemplateBinding PlaceholderText}"
                         PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                         IsReadOnly="{TemplateBinding IsReadOnly}"
                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                         Text="{TemplateBinding Text}"
                         TextAlignment="{TemplateBinding TextAlignment}"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         InnerLeftContent="{Binding InnerLeftContent, RelativeSource={RelativeSource TemplatedParent}}"/>
              </DockPanel>
            </ButtonSpinner>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:focus-within /template/ TextBox#PART_TextBox">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

</Styles>
