<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>d47</AssemblyName>
    <RootNamespace>D47.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>bin\$(Configuration)\publish\</PublishDir>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="DevInstallRoot" Value="$(LOCALAPPDATA)\Programs\d47" />
  </ItemGroup>

  <!-- D47Icon is the exe icon and the window icon. D47BuildMark, when set, colours the caption diamond to
       match it (Palettes.BuildMark). A Debug build is marked test-drive. -->
  <PropertyGroup>
    <D47Icon Condition="'$(D47Icon)' == '' and '$(Configuration)' == 'Debug'">..\..\assets\directive-47-test-drive.ico</D47Icon>
    <D47Icon Condition="'$(D47Icon)' == ''">..\..\assets\directive-47.ico</D47Icon>
    <D47BuildMark Condition="'$(D47BuildMark)' == '' and '$(Configuration)' == 'Debug'">test-drive</D47BuildMark>
    <ApplicationIcon>$(D47Icon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(D47BuildMark)' != ''">
    <AssemblyMetadata Include="BuildMark" Value="$(D47BuildMark)" />
  </ItemGroup>

  <!-- D47CommitTime, passed by the test-drive and local-release scripts, follows the version in the title bar. -->
  <ItemGroup Condition="'$(D47CommitTime)' != ''">
    <AssemblyMetadata Include="CommitTime" Value="$(D47CommitTime)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="$(D47Icon)" Link="Assets\directive-47.ico" />
    <AvaloniaResource Include="..\..\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\fonts\OFL-*.txt"
          Link="fonts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\ships\*.png"
          Exclude="..\..\assets\ships\*.4k.png"
          Link="ships\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\engineers\*.jpg"
          Link="engineers\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\portraits\*.jpg"
          Link="portraits\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\codex-placeholders\*.jpg"
          Link="codex-placeholders\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\voices\chatterbox\*"
          Link="voices\chatterbox\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D47.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D47.Core\D47.Core.csproj" />
    <ProjectReference Include="..\D47.Audio\D47.Audio.csproj" />
    <ProjectReference Include="..\D47.Knowledge\D47.Knowledge.csproj" />
    <ProjectReference Include="..\D47.Llm\D47.Llm.csproj" />
    <ProjectReference Include="..\D47.Modules\D47.Modules.csproj" />
    <ProjectReference Include="..\D47.Stt\D47.Stt.csproj" />
    <ProjectReference Include="..\D47.Tts\D47.Tts.csproj" />
    <ProjectReference Include="..\D47.Vr\D47.Vr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- The OpenXR layer: published with NativeAOT to a folder of its own, then the DLL and its manifest are
       copied to runtimes\openxr\. Not a ProjectReference, so neither file enters d47.exe's bundle. -->
  <Target Name="PublishTheOpenXrLayer" AfterTargets="Publish">
    <PropertyGroup>
      <_XrLayerProject>$(MSBuildProjectDirectory)\..\D47.XrLayer\D47.XrLayer.csproj</_XrLayerProject>
      <_XrLayerPublishDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)xrlayer\$(Configuration)\</_XrLayerPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(_XrLayerProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(_XrLayerProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_XrLayerPublishDir)" />
    <Copy SourceFiles="$(_XrLayerPublishDir)XR_APILAYER_D47_panel.dll;$(_XrLayerPublishDir)XR_APILAYER_D47_panel.json"
          DestinationFolder="$(PublishDir)runtimes\openxr\" />
  </Target>

  <!-- A build of this project alone, as the test drive and the local release run it, puts the NativeAOT
       layer in runtimes\openxr\ beside d47.exe, publishing only when the layer's sources are newer. A
       solution build skips it: it builds D47.XrLayer itself, and the nested publish would write the same obj
       folder. A publish skips it: PublishTheOpenXrLayer puts the layer in the publish folder. -->
  <ItemGroup Condition="'$(BuildingSolutionFile)' != 'true' And '$(_IsPublishing)' != 'true'">
    <_XrLayerSource Include="..\D47.XrLayer\**\*.cs;..\D47.XrLayer\D47.XrLayer.csproj;..\D47.XrLayer\XR_APILAYER_D47_panel.json"
                    Exclude="..\D47.XrLayer\bin\**;..\D47.XrLayer\obj\**" />
  </ItemGroup>

  <Target Name="PutTheOpenXrLayerBesideTheBuild" AfterTargets="Build"
          Condition="'$(BuildingSolutionFile)' != 'true' And '$(_IsPublishing)' != 'true'"
          Inputs="@(_XrLayerSource)"
          Outputs="$(OutDir)runtimes\openxr\XR_APILAYER_D47_panel.dll;$(OutDir)runtimes\openxr\XR_APILAYER_D47_panel.json">
    <PropertyGroup>
      <_XrLayerProject>$(MSBuildProjectDirectory)\..\D47.XrLayer\D47.XrLayer.csproj</_XrLayerProject>
      <_XrLayerPublishDir>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), 'xrlayer', $(Configuration)))</_XrLayerPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(_XrLayerProject)" Targets="Restore"
             Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(_XrLayerProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_XrLayerPublishDir);_IsPublishing=true" />
    <Copy SourceFiles="$(_XrLayerPublishDir)XR_APILAYER_D47_panel.dll;$(_XrLayerPublishDir)XR_APILAYER_D47_panel.json"
          DestinationFolder="$(OutDir)runtimes\openxr\" />
    <Touch Files="$(OutDir)runtimes\openxr\XR_APILAYER_D47_panel.dll;$(OutDir)runtimes\openxr\XR_APILAYER_D47_panel.json" />
  </Target>

  <Target Name="ShipWhisperNativesBesideTheExe" AfterTargets="_ComputeCopyToPublishDirectoryItems">
    <ItemGroup>
      <_WhisperNative
          Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) and $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('whisper'))" />
      <ResolvedFileToPublish Remove="@(_WhisperNative)" />
      <ResolvedFileToPublish
          Include="@(_WhisperNative)"
          Condition="$([System.String]::Copy('%(_WhisperNative.RelativePath)').Contains('win-x64'))"
          ExcludeFromSingleFile="true" />
    </ItemGroup>
    <Message Importance="high" Text="WHISPER-NATIVE beside the exe: %(_WhisperNative.RelativePath)"
             Condition="$([System.String]::Copy('%(_WhisperNative.RelativePath)').Contains('win-x64'))" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
