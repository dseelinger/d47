<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Overrides the plain net10.0-windows Directory.Build.props sets for every other project.
      Windows.Gaming.Input.RawGameController is the HOTAS read path (list.md Phase 21,
      docs/spikes/hotas-switch-read.md) and it is reachable only through the Windows SDK
      projections, which need a versioned target platform. Nothing else here depends on the
      version, so this is the one project that carries it — and D47.App.Tests, which cannot
      reference a project targeting a platform version above its own.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>d47</AssemblyName>
    <RootNamespace>D47.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Publish settings live here so `dotnet publish` needs no flags (architecture.md §9).
    Not trimmed and not NativeAOT: Whisper.net and openvr_api are native P/Invoke
    targets and Avalonia still leans on reflection. Revisit once that set is stable.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      Publish output goes somewhere the target framework is not part of the path.

      The default is bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish, and
      three files outside this project spelled that out in full: both workflows and the Inno
      Setup script. Phase 21 changed the framework from net10.0-windows to
      net10.0-windows10.0.26100.0 and every one of them kept pointing at a directory that no
      longer exists. That is not a build failure, because the publish itself succeeded. It is a
      release failing after the tag is pushed, and a tag never moves, so it cost the version
      number v0.16.0.

      Setting it here rather than passing -o keeps the rule this csproj already exists for:
      publish settings live in the project so local and CI cannot diverge (architecture.md 9),
      and `dotnet publish src/D47.App -c Release` still needs no flags. The path now has no
      framework in it, so the next framework change cannot repeat this.
    -->
    <PublishDir>bin\$(Configuration)\publish\</PublishDir>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Symbols inside the exe: stack traces keep line numbers without shipping a second file. -->
    <DebugType>embedded</DebugType>
    <!-- Stops third-party .pdb files (libSkiaSharp's is 84 MB) landing in publish output. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    Where a Debug build writes, and it is not beside the Debug executable.

    Everything d47 writes lives in data\ beside the exe, which is right for an installed app and
    means a *Debug* exe writes into bin\Debug. So the dev checklist, settings and secrets lived in
    build output, and on 2026-08-23 deleting bin\Debug to clear a stale artifact deleted them —
    two hours of diagnosis ending in data loss because the obvious remedy was destructive.

    Debug only, and read through AssemblyMetadata rather than an environment variable: a published
    build carries no such attribute, so the shipped rule is provably untouched and nothing outside
    the build can redirect where secrets are written. A test host has no entry-assembly attribute
    either, so the suite is unaffected. See AppPaths.ForRunningBuild.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="DevDataRoot" Value="$(MSBuildThisFileDirectory)..\..\dev-data" />
  </ItemGroup>

  <!--
    The mark, in the two places it is read from. ApplicationIcon compiles it into the
    executable's icon resource, which is what Explorer, the taskbar and alt-tab read with
    nothing running. AvaloniaResource is what the windows read at runtime for their title
    bars - Avalonia, unlike WPF, does not fall back to the executable's icon.

    One file, linked from the repository root rather than copied into this project, because
    assets/ is repository content and a second copy is a second thing to keep in step.
  -->
  <PropertyGroup>
    <ApplicationIcon>..\..\assets\directive-47.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\directive-47.ico" Link="Assets\directive-47.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D47.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D47.Core\D47.Core.csproj" />
    <ProjectReference Include="..\D47.Audio\D47.Audio.csproj" />
    <ProjectReference Include="..\D47.Knowledge\D47.Knowledge.csproj" />
    <ProjectReference Include="..\D47.Llm\D47.Llm.csproj" />
    <ProjectReference Include="..\D47.Stt\D47.Stt.csproj" />
    <ProjectReference Include="..\D47.Tts\D47.Tts.csproj" />
    <ProjectReference Include="..\D47.Vr\D47.Vr.csproj" />
  </ItemGroup>

  <!--
    Avalonia.BuildServices is build-time telemetry that Avalonia pulls in transitively: an
    MSBuild task that phones home on every compile. It never ships in the exe, but "no
    telemetry" should not come with a "runtime only" asterisk, and the package's own opt-out
    is an environment variable someone has to remember on every machine. ExcludeAssets="all"
    keeps its .targets from being imported at all, so the task simply never runs.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzzSharp ship native .pdb files as runtime assets (105 MB between
    them). Symbols for our own code are embedded in the exe, so nothing in publish output
    should be a .pdb.
  -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!--
    Whisper's natives ship as loose files under runtimes\win-x64\, never inside the
    single-file bundle. Whisper.net's loader does not use normal native resolution: it
    probes the disk for <exe dir>\runtimes\win-x64\whisper.dll (Directory.Exists +
    File.Exists) and throws when the folder is not there. Bundled natives extract to a
    temp folder the loader never probes, so a bundled whisper.dll is a whisper.dll that
    cannot be found — transcription worked in dev builds, where this layout exists in
    bin\, and failed in every published one. The other architectures' copies are dropped
    outright: a win-x64 publish has no use for win-arm64 or win-x86 natives.
  -->
  <!--
    The natives are None items in D47.Stt (Whisper.net.Runtime.targets), which reach this
    project's publish through the child-project recursion in GetCopyToPublishDirectoryItems
    and only become ResolvedFileToPublish in _ComputeCopyToPublishDirectoryItems — hence the
    private-target hook; an SDK rename here fails loud in the selftest release gate.
  -->
  <Target Name="ShipWhisperNativesBesideTheExe" AfterTargets="_ComputeCopyToPublishDirectoryItems">
    <ItemGroup>
      <_WhisperNative
          Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) and $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('whisper'))" />
      <ResolvedFileToPublish Remove="@(_WhisperNative)" />
      <ResolvedFileToPublish
          Include="@(_WhisperNative)"
          Condition="$([System.String]::Copy('%(_WhisperNative.RelativePath)').Contains('win-x64'))"
          ExcludeFromSingleFile="true" />
    </ItemGroup>
    <!-- Only what actually ships: the dropped arm64/x86 copies would read as shipped too. -->
    <Message Importance="high" Text="WHISPER-NATIVE beside the exe: %(_WhisperNative.RelativePath)"
             Condition="$([System.String]::Copy('%(_WhisperNative.RelativePath)').Contains('win-x64'))" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
