<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>d47</AssemblyName>
    <RootNamespace>D47.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Publish settings live here so `dotnet publish` needs no flags (architecture.md §9).
    Not trimmed and not NativeAOT: Whisper.net and openvr_api are native P/Invoke
    targets and Avalonia still leans on reflection. Revisit once that set is stable.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Symbols inside the exe: stack traces keep line numbers without shipping a second file. -->
    <DebugType>embedded</DebugType>
    <!-- Stops third-party .pdb files (libSkiaSharp's is 84 MB) landing in publish output. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    The mark, in the two places it is read from. ApplicationIcon compiles it into the
    executable's icon resource, which is what Explorer, the taskbar and alt-tab read with
    nothing running. AvaloniaResource is what the windows read at runtime for their title
    bars - Avalonia, unlike WPF, does not fall back to the executable's icon.

    One file, linked from the repository root rather than copied into this project, because
    assets/ is repository content and a second copy is a second thing to keep in step.
  -->
  <PropertyGroup>
    <ApplicationIcon>..\..\assets\directive-47.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\directive-47.ico" Link="Assets\directive-47.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D47.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D47.Core\D47.Core.csproj" />
    <ProjectReference Include="..\D47.Audio\D47.Audio.csproj" />
    <ProjectReference Include="..\D47.Llm\D47.Llm.csproj" />
    <ProjectReference Include="..\D47.Stt\D47.Stt.csproj" />
    <ProjectReference Include="..\D47.Tts\D47.Tts.csproj" />
    <ProjectReference Include="..\D47.Vr\D47.Vr.csproj" />
  </ItemGroup>

  <!--
    Avalonia.BuildServices is build-time telemetry that Avalonia pulls in transitively: an
    MSBuild task that phones home on every compile. It never ships in the exe, but "no
    telemetry" should not come with a "runtime only" asterisk, and the package's own opt-out
    is an environment variable someone has to remember on every machine. ExcludeAssets="all"
    keeps its .targets from being imported at all, so the task simply never runs.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzzSharp ship native .pdb files as runtime assets (105 MB between
    them). Symbols for our own code are embedded in the exe, so nothing in publish output
    should be a .pdb.
  -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
