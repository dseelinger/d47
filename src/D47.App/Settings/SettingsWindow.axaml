<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:D47.App.Settings"
        x:Class="D47.App.Settings.SettingsWindow"
        Title="Directive 47 — Settings"
        Icon="/Assets/directive-47.ico"
        Width="900" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource D47.Background}">

  <!-- The window is the desktop host for the view, and nothing more. The view itself knows
       nothing about windows, which is what lets Phase 9 hand it to an OpenVR overlay. -->
  <settings:SettingsView x:Name="View" />
</Window>
