<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The speech-to-text end of the voice path. Its own project for the same reason D47.Audio and
    D47.Tts are: Core must never reference Whisper.net or its native runtime, and a project
    reference is the only way to say that in a way the build enforces (architecture.md §3).
    Everything above ISpeechTranscriber is gate policy and lives in Core, where it is testable
    with no model present and no microphone.
  -->

  <ItemGroup>
    <ProjectReference Include="..\D47.Core\D47.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      So the prompt the transcriber is biased with can be asserted without a 75 MB model on disk
      (remediation.md 10, item 17).
    -->
    <InternalsVisibleTo Include="D47.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />

    <!-- The CPU runtime. Always shipped, and the fallback whenever the GPU one does not load. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />

    <!--
      The GPU runtime, and Vulkan rather than CUDA on purpose (#187).

      Vulkan is about 58 MB of win-x64 natives against CUDA 11's 148 MB and CUDA 12's more, it
      runs on AMD and Intel GPUs as well as NVIDIA, and it bundles no vendor runtime at all — it
      calls whatever Vulkan driver the machine already has. The CUDA packages ship one ~147 MB
      DLL with no cuBLAS or cudart beside it, which is what NVIDIA's math libraries statically
      linked in looks like; every one of these packages declares MIT, so the licence gate would
      pass it either way, and the gate reads nuspec metadata rather than what a binary contains.
      Vulkan avoids that question rather than answering it.

      Small enough to ship in the installer, which is what keeps this out of the model-download
      path: 58 MB beside the executable against a 1 GB models folder that is already fetched.
    -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

</Project>
