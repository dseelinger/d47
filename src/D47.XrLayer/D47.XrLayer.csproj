<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loaded into Elite's process by the OpenXR loader, so it references nothing else in the solution.
       A build compiles it as managed code; a publish compiles it with NativeAOT. -->
  <PropertyGroup>
    <AssemblyName>XR_APILAYER_D47_panel</AssemblyName>
    <RootNamespace>D47.XrLayer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No symbols: ILCompiler links with /DEBUG whenever DebugType is set, and a PDB left by an earlier
         publish changes the PDB GUID written into the DLL. -->
    <DebugType>none</DebugType>
    <NativeDebugSymbols>false</NativeDebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D47.XrLayer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="XR_APILAYER_D47_panel.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reproducible link: two publishes of one commit give the same DLL. -->
  <ItemGroup>
    <LinkerArg Include="/Brepro" />
  </ItemGroup>

</Project>
