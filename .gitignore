# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
publish/
# The /release skill, which the line above would otherwise catch
!.claude/skills/release/

# The Debug build's data root — settings, secrets and a 325 MB model, none of it source
dev-install/data/

# Inno Setup output (OutputDir is installer\)
installer/d47-setup-*.exe
installer/*.sha256

# Release artifacts built by hand
d47.zip
d47.zip.sha256

# Python generators
__pycache__/
*.py[cod]

# Tooling
.vs/
.idea/
*.user
*.suo

# wrangler's machine-local state from Worker provisioning; never repository material
worker/.wrangler/
ratings-worker/.wrangler/
usage-worker/.wrangler/
web-worker/.wrangler/
/.wrangler/

# The last triage's grid, read by the issue launcher. A snapshot of a queue that moves.
.claude/triage-state.json

# Claude Code's per-machine settings and notes. Permission rules are saved from real commands and
# can hold a key or token.
**/.claude/settings.local.json
**/CLAUDE.local.md
.mcp.json

# Lane worktrees, one per issue in progress; removed when the issue merges
.claude/worktrees/

# Avatar clips are published to the avatars-1 release, not committed
design/avatars/

# Skill eval results from tools/evals/skill-evals.ps1
.claude/skills/*/evals/results/
