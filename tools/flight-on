#!/usr/bin/env bash
#
# flight-on, from bash. A shim and deliberately nothing more.
#
# Where d47 is installed, what the switch is called, and what happens when one is already running
# live in flight-on.ps1 and only there. A second implementation here would be two things that have
# to agree about all of that, and this repository has a rule about those: two lists that must agree
# are two lists that will not.
#
# So this finds the script, hands over the arguments unchanged, and gets out of the way.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
script="$here/flight-on.ps1"

# PowerShell is a Windows program and does not understand an MSYS path like /c/dev/d47. cygpath is
# present in Git Bash and WSL alike; if it is missing the path was probably already a Windows one.
if command -v cygpath >/dev/null 2>&1; then
  script="$(cygpath -w "$script")"
fi

for candidate in pwsh powershell powershell.exe; do
  if command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" -NoProfile -ExecutionPolicy Bypass -File "$script" "$@"
  fi
done

echo "flight-on: no PowerShell found (looked for pwsh, powershell)." >&2
exit 1
