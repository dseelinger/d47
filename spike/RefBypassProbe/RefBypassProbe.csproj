<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Deliberately bypasses the ref/ assemblies by pointing straight at lib/. -->
  <ItemGroup>
    <Reference Include="Avalonia.Base">
      <HintPath>$(NuGetPackageRoot)avalonia/12.1.1/lib/net10.0/Avalonia.Base.dll</HintPath>
    </Reference>
    <Reference Include="Avalonia.Controls">
      <HintPath>$(NuGetPackageRoot)avalonia/12.1.1/lib/net10.0/Avalonia.Controls.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
