<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Says a sentence through Edge Neural, optionally over RadioVoice's comms link, and writes it
    out as a WAV so it can be listened to. The one question a test cannot answer about an audio
    effect is whether it sounds right.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RadioAudition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\D47.Tts\D47.Tts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
