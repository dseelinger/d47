* text=auto

# Journal fixtures are replayed byte-for-byte (architecture.md §8). Never normalise
# line endings and never try to diff them.
tests/fixtures/** -text -diff
*.log -text -diff

# Binary assets
*.png binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary

# Shell scripts are LF, always. `* text=auto` above plus core.autocrlf=true checks these out with
# CRLF on Windows, and a shebang followed by a carriage return is not an interpreter path: bash
# answers `bad interpreter: /usr/bin/env bash^M` and the script is dead on a fresh clone. It runs
# in the working tree it was written in, which is the worst way for this to fail.
tools/get-ver text eol=lf
tools/get-local text eol=lf
*.sh text eol=lf
tools/prerelease text eol=lf
tools/promote text eol=lf
tools/rec-on text eol=lf
tools/prune-branches text eol=lf
