<Project>

  <!-- One place for anything every project shares. Add to this rather than to a csproj. -->
  <PropertyGroup>
    <!-- Windows-only by design: DPAPI, SendInput, the journal paths and OpenVR all assume it
         (architecture.md §1). Declared once here so individual call sites need no annotation. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- No telemetry (CLAUDE.md), and the rule reaches the toolchain rather than only the
         product. Microsoft.NET.Test.Sdk pulls Microsoft.Testing.Extensions.Telemetry into every
         test project's graph by default; this is the documented opt-out, set here so a test
         project cannot be added without it. Nothing shipped ever referenced it — the packages
         are test-only — but "no telemetry" is not a claim worth qualifying. -->
    <TestingPlatformTelemetryOptOut>true</TestingPlatformTelemetryOptOut>
  </PropertyGroup>

  <!-- Release version comes from the git tag via CI; this is the local fallback. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Product>d47</Product>
    <Authors>Doug Seelinger</Authors>
  </PropertyGroup>

</Project>
