<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\D47.Core\D47.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\D47.Knowledge.Tests\Fixtures\spansh-fleetcarrier-route-*.json" LogicalName="Fixtures.%(Filename)%(Extension)" />
