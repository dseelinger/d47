        "{ \"timestamp\":\"2026-08-18T12:00:01Z\", \"event\":\"Loadout\", \"Ship\":\"asp\", \"ShipID\":1, \"ShipName\":\"{{payload}}\", \"ShipIdent\":\"D47-1\", \"HullHealth\":1.0, \"MaxJumpRange\":34.7, \"CargoCapacity\":64 }"
      ],
